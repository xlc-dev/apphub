{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "iconSource": {
      "type": "string",
      "format": "uri"
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "releaseSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
            }
          },
          "required": ["type", "repository"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "direct"
            }
          },
          "required": ["type"],
          "additionalProperties": false,
          "description": "Release metadata and artifact URLs are maintained in releases.json"
        }
      ]
    },
    "screenshots": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^screenshot-[1-9][0-9]*\\.(?:png|jpe?g|webp)$"
          },
          "caption": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["file"],
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "isolation": {
          "type": "string",
          "const": "none"
        },
        "expectedAccess": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "network",
              "home-files",
              "removable-media",
              "devices",
              "session-bus",
              "system-bus"
            ]
          }
        }
      },
      "required": ["isolation", "expectedAccess"],
      "additionalProperties": false,
      "description": "Expected application behavior, not enforced permissions; AppImages run unsandboxed as the user"
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_+-]*$",
        "description": "Linux architecture name"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["id", "name", "summary", "iconSource", "releaseSource", "screenshots", "security"],
  "additionalProperties": false,
  "title": "AppHub application"
}
