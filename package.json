{
  "name": "apphub",
  "type": "module",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#catalog/*": "./catalog/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "test": "bun test",
    "test:node": "node --test tests/*.test.ts",
    "generate-catalog": "node scripts/generate-catalog.ts",
    "update-downloads": "node scripts/update-downloads.ts",
    "update-stars": "node scripts/update-stars.ts",
    "validate:catalog": "node scripts/validate.ts",
    "validate:project": "astro check && astro build && node scripts/validate.ts",
    "validate": "prettier --check . && bun test && bun run validate:project",
    "validate:node": "prettier --check . && node --test tests/*.test.ts && astro check && astro build && node scripts/validate.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "fast-xml-parser": "^5.11.0",
    "sharp": "^0.35.3",
    "spdx-expression-parse": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.18.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
