{
  "name": "apphub",
  "type": "module",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.28.9",
  "imports": {
    "#catalog/*": "./catalog/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "astro check",
    "test": "node --test tests/*.test.ts",
    "test:scale": "node scripts/test-scale.ts",
    "generate-catalog": "node scripts/generate-catalog.ts",
    "plan-github-publication": "node scripts/media/plan.ts",
    "publish-github-media": "node scripts/media/publish.ts",
    "plan-refresh": "node scripts/refresh/plan.ts",
    "run-refresh-batch": "node scripts/refresh/run-batch.ts",
    "finalize-refresh-batches": "node scripts/refresh/finalize.ts",
    "create-tuf-root": "node scripts/tuf/create-root.ts",
    "generate-tuf": "node scripts/tuf/generate.ts",
    "update-revocations": "node scripts/tuf/update-revocations.ts",
    "validate-tuf": "node scripts/tuf/validate.ts",
    "validate-revocations": "node scripts/tuf/validate-revocations.ts",
    "update-downloads": "node scripts/update-downloads.ts",
    "update-stars": "node scripts/update-stars.ts",
    "validate:catalog": "node scripts/validate.ts",
    "validate:dist": "node scripts/validate-api.ts && node scripts/validate-locales.ts && node scripts/validate-security.ts && node scripts/validate-site-size.ts && node scripts/validate-base-path.ts && node scripts/validate-discovery.ts && node scripts/validate-release-media.ts",
    "validate:project": "astro check && node scripts/validate.ts && BASE_PATH=/apphub astro build && pnpm run validate:dist",
    "validate": "prettier --check . && eslint . && pnpm run test && pnpm run validate:project"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "fast-xml-parser": "^5.11.2",
    "sharp": "^0.35.5",
    "spdx-expression-parse": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "~3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
