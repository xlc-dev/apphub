{
  "name": "apphub",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "schema": "bun scripts/generate-schema.ts && prettier --write app.schema.json",
    "test": "bun test",
    "validate:catalog": "bun scripts/validate.ts",
    "verify:downloads": "bun scripts/verify-downloads.ts",
    "validate": "prettier --check . && astro check && bun test && astro build && bun scripts/validate.ts",
    "update-releases": "bun scripts/update-releases.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
