{"id":"dev.geopjr.Collision","name":"Collision","summary":"Check hashes for your files","description":"Verifying that a file you downloaded or received is actually the one you were expecting is often overlooked or too time-consuming to do. At the same time, it has become very easy to get your hands on a file that has been tampered with, due to the mass increase of malicious webpages and other actors. This tool aims to solve that. Collision comes with a simple & clean UI, allowing anyone, from any age and experience group, to generate, compare and verify MD5, SHA-256, SHA-512, SHA-1, Blake3, CRC32 and Adler32 hashes.","projectLicense":"BSD-2-Clause","developer":{"name":"Evangelos \"GeopJr\" Paterakis","url":"https://collision.geopjr.dev/"},"homepage":"https://collision.geopjr.dev/","repository":"https://codeberg.org/GeopJr/Collision/","addedAt":"2026-08-22","keywords":["md5","sha1","sha256"],"categories":["Utility"],"source":"community","icon":{"license":"BSD-2-Clause","source":"https://dl.flathub.org/media/dev/geopjr/Collision/5b0d8fea872d336b2510c1f29bd0fcb9/icons/128x128/dev.geopjr.Collision.png","url":"data:image/png;base64,","type":"image/png"},"sandbox":{"network":"none","display":"wayland-and-x11","audio":"none","processes":"isolated","ipc":false,"filesystem":[],"devices":["gpu"],"portals":["file-chooser","settings"],"sessionBus":[],"systemBus":[]},"slug":"collision","screenshots":[{"caption":"Collision main window","license":"BSD-2-Clause","source":"https://dl.flathub.org/media/dev/geopjr/Collision/5b0d8fea872d336b2510c1f29bd0fcb9/screenshots/image-1_orig.png","url":"/apphub/d7116acd268c2ed8a643ea4adc1512c988b55cad/_astro/screenshot-1.Bf8d_zWc.png","type":"image/png"}],"releases":[{"version":"3.14.1-1@2026-08-22_1787395253","publishedAt":"2026-08-22T10:40:54Z","page":"https://github.com/pkgforge-dev/Collision-AppImage/releases/tag/3.14.1-1%402026-08-22_1787395253","artifacts":[{"architecture":"aarch64","name":"Collision-3.14.1-1-anylinux-aarch64.AppImage","ur