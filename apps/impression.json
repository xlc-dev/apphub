{
  "appstream": {
    "type": "flathub",
    "id": "io.gitlab.adhami3310.Impression"
  },
  "addedAt": "2026-08-22",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Impression-AppImage"
  },
  "sandbox": {
    "network": "full",
    "display": "wayland-or-x11",
    "audio": "none",
    "processes": "isolated",
    "ipc": false,
    "filesystem": [
      {
        "location": "downloads",
        "access": "read-only"
      },
      {
        "location": "removable-media",
        "access": "read-write"
      }
    ],
    "devices": ["gpu", "usb"],
    "sessionBus": {
      "access": "none",
      "rules": []
    },
    "systemBus": {
      "access": "filtered",
      "rules": [
        {
          "name": "org.freedesktop.UDisks2",
          "access": "talk"
        }
      ]
    }
  }
}
