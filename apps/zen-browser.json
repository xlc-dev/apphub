{
  "appstream": {
    "type": "flathub",
    "id": "app.zen_browser.zen"
  },
  "addedAt": "2026-11-07",
  "origin": {
    "type": "third-party"
  },
  "releaseSource": {
    "type": "github",
    "repository": "zen-browser/desktop"
  },
  "sandbox": {
    "network": "full",
    "audio": "full",
    "display": "wayland-or-x11",
    "processes": "isolated",
    "ipc": false,
    "filesystem": [
      {
        "location": "downloads",
        "access": "read-write"
      }
    ],
    "devices": [
      "gpu"
    ],
    "sessionBus": {
      "access": "filtered",
      "rules": [
        {
          "name": "org.freedesktop.Notifications",
          "access": "talk"
        },
        {
          "name": "org.kde.StatusNotifierWatcher",
          "access": "talk"
        },
        {
          "name": "org.mpris.MediaPlayer2.ZenBrowser",
          "access": "own"
        }
      ]
    },
    "systemBus": {
      "access": "filtered",
      "rules": [
        {
          "name": "org.freedesktop.login1",
          "access": "talk"
        }
      ]
    }
  }
}