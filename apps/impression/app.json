{
  "appstream": {
    "type": "flathub",
    "id": "io.gitlab.adhami3310.Impression"
  },
  "addedAt": "2026-08-22",
  "source": "community",
  "releaseSource": {
    "type": "github",
    "repository": "pkgforge-dev/Impression-AppImage"
  },
  "sandbox": {
    "network": "client",
