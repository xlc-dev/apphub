    "devices": ["gpu", "usb"],
    "portals": ["file-chooser", "notifications", "settings"],
    "sessionBus": [],
    "systemBus": [
      {
        "name": "org.freedesktop.UDisks2",
        "access": "talk"
      }
    ]
  }
