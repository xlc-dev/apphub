---
import Button from "@/components/ui/Button.astro";

interface Props {
  label?: string;
  pageSize?: number;
  class?: string;
}

const { label = "apps", pageSize = 24, class: className } = Astro.props;
---

<div data-paginated-list data-page-size={pageSize}>
  <div class={className} data-page-items>
    <slot />
  </div>
  <nav
    class="mt-8 hidden items-center justify-center gap-4"
    aria-label={`${label} pages`}
    data-pagination>
    <Button data-page-previous>Previous</Button>
    <span
      class="min-w-24 text-center text-sm text-[var(--muted)]"
      aria-live="polite"
      data-page-status></span>
    <Button data-page-next>Next</Button>
  </nav>
</div>

<script>
  import { paginationState } from "@/lib/pagination";

  function initializePagination() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-paginated-list]")) {
      if (root.dataset.initialized) continue;

      const container = root.querySelector<HTMLElement>("[data-page-items]");
      const navigation = root.querySelector<HTMLElement>("[data-pagination]");
      const previous = root.querySelector<HTMLButtonElement>("[data-page-previous]");
      const next = root.querySelector<HTMLButtonElement>("[data-page-next]");
      const status = root.querySelector<HTMLElement>("[data-page-status]");

      if (!container || !navigation || !previous || !next || !status) continue;

      const items = Array.from(
        container.querySelectorAll<HTMLElement>(":scope > [data-page-item]")
      );
      const pageSize = Number(root.dataset.pageSize) || 24;
      const events = new AbortController();
      let page = Math.max(1, Number(new URLSearchParams(location.search).get("page")) || 1);

      root.dataset.initialized = "true";

      const render = (updateUrl = false) => {
        const matches = items.filter(
          (item) => item.dataset.searchMatch !== "false" && item.dataset.categoryMatch !== "false"
        );
        const state = paginationState(matches.length, page, pageSize);
        page = state.page;
        const visible = new Set(matches.slice(state.start, state.end));

        items.forEach((item) => (item.hidden = !visible.has(item)));
        navigation.classList.toggle("hidden", state.pages <= 1);
        navigation.classList.toggle("flex", state.pages > 1);
        previous.disabled = page === 1;
        next.disabled = page === state.pages;
        status.textContent = `Page ${page} of ${state.pages}`;

        if (updateUrl) {
          const url = new URL(location.href);
          if (page === 1) url.searchParams.delete("page");
          else url.searchParams.set("page", String(page));
          history.pushState({}, "", url);
        }
      };

      previous.addEventListener("click", () => {
        page--;
        render(true);
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      next.addEventListener("click", () => {
        page++;
        render(true);
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      root.addEventListener("apphub:filter", (event) => {
        if ((event as CustomEvent<{ resetPage: boolean }>).detail.resetPage) {
          page = 1;
          const url = new URL(location.href);
          url.searchParams.delete("page");
          history.replaceState({}, "", url);
        }
        render();
      });
      addEventListener(
        "popstate",
        () => {
          page = Math.max(1, Number(new URLSearchParams(location.search).get("page")) || 1);
          render();
        },
        { signal: events.signal }
      );
      document.addEventListener("astro:before-swap", () => events.abort(), { once: true });

      render();
    }
  }

  document.addEventListener("astro:page-load", initializePagination);
</script>
