---
import Link from "@/components/ui/Link.astro";
import { Image } from "astro:assets";

const path = Astro.url.pathname;
const links = [
  { href: "/apps/", label: "Apps", current: path.startsWith("/apps/") },
  { href: "/new/", label: "New", current: path === "/new/" },
  { href: "/categories/", label: "Categories", current: path.startsWith("/categories/") },
  { href: "/trending/", label: "Trending", current: path.startsWith("/trending/") },
];
---

<header
  class="shadow-surface/5 dark:border-control/80 dark:bg-surface/90 sticky top-0 z-50 w-full border-b border-zinc-200/80 bg-white/90 shadow-sm backdrop-blur-md dark:shadow-black/20">
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-[1fr_auto] items-center gap-4 px-4 py-4 md:grid-cols-[auto_minmax(12rem,32rem)_auto] md:px-6">
    <a
      class="col-start-1 row-start-1 flex items-center gap-2 justify-self-start rounded-sm text-xl font-bold focus-visible:outline-2 focus-visible:outline-offset-2"
      aria-label="AppHub home"
      href="/">
      <Image src="/logo.svg" alt="" width={32} height={32} loading="eager" fetchpriority="high" />
      <span class="hidden sm:inline">AppHub</span>
    </a>
    <div class="col-start-2 row-start-1 md:hidden">
      <button
        class="group focus-visible:outline-accent flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-zinc-300 focus-visible:outline-2 focus-visible:outline-offset-2 dark:border-zinc-700"
        type="button"
        aria-label="Main menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle>
        <svg
          class="group-aria-expanded:hidden"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="hidden group-aria-expanded:block"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
      <nav
        class="dark:bg-surface/95 invisible absolute top-full right-0 left-0 grid grid-rows-[0fr] border-t border-zinc-200 bg-white/95 opacity-0 shadow-lg backdrop-blur-md transition-[grid-template-rows,opacity,visibility] duration-200 data-[open]:visible data-[open]:grid-rows-[1fr] data-[open]:opacity-100 motion-reduce:transition-none dark:border-zinc-800"
        id="mobile-navigation"
        aria-label="Main navigation"
        aria-hidden="true"
        inert
        data-mobile-navigation>
        <div class="overflow-hidden">
          <div class="mx-auto grid max-w-6xl gap-1 px-4 py-3">
            {
              links.map(({ href, label, current }) => (
                <Link
                  class="aria-[current=page]:bg-accent/10 flex min-h-11 items-center rounded-lg border-0 px-3 py-2.5 font-medium"
                  href={href}
                  aria-current={current ? "page" : undefined}>
                  {label}
                </Link>
              ))
            }
          </div>
        </div>
      </nav>
    </div>
    <form
      class="col-span-2 col-start-1 row-start-2 w-full md:col-span-1 md:col-start-2 md:row-start-1"
      action="/apps/"
      method="get"
      role="search"
      hidden
      data-catalog-search>
      <label class="sr-only" for="catalog-search">Search apps</label>
      <input
        class="focus-visible:border-surface focus-visible:ring-surface/20 dark:bg-control dark:focus-visible:border-foreground dark:focus-visible:ring-foreground/20 min-h-11 w-full rounded-lg border border-zinc-300 bg-transparent px-3 py-2 outline-none focus-visible:ring-2 dark:border-zinc-700"
        id="catalog-search"
        type="search"
        name="q"
        placeholder="Search apps"
        autocomplete="off"
        data-catalog-search-input
      />
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav
      class="col-start-3 row-start-1 hidden justify-end gap-x-4 text-base md:flex"
      aria-label="Main navigation">
      {
        links.map(({ href, label, current }) => (
          <Link href={href} aria-current={current ? "page" : undefined}>
            {label}
          </Link>
        ))
      }
    </nav>
  </div>
</header>

<script>
  function initMobileNavigation() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const navigation = document.querySelector<HTMLElement>("[data-mobile-navigation]");
    if (!toggle || !navigation) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      navigation.toggleAttribute("data-open", open);
      navigation.setAttribute("aria-hidden", String(!open));
      navigation.inert = !open;
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true")
    );
    toggle.parentElement?.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  function showHeaderSearch() {
    const search = document.querySelector<HTMLFormElement>("[data-catalog-search]");
    if (search) search.hidden = false;
  }

  document.addEventListener("astro:page-load", () => {
    showHeaderSearch();
    initMobileNavigation();
  });
</script>
