---
import Link from "@/components/ui/Link.astro";
import ThemeSelect from "@/components/ThemeSelect.astro";
import { routePath, sitePath } from "@/lib/paths";
import { Image } from "astro:assets";

const path = routePath(Astro.url.pathname);
const logo = sitePath("/logo.svg");
const links = [
  {
    href: "/apps/",
    label: "Apps",
    current: path.startsWith("/apps/") || path.startsWith("/categories/"),
  },
  { href: "/new/", label: "New", current: path.startsWith("/new/") },
  { href: "/trending/", label: "Trending", current: path.startsWith("/trending/") },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--page)_90%,transparent)] shadow-sm backdrop-blur-md">
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto] items-center gap-4 px-4 py-3 md:grid-cols-[auto_minmax(12rem,32rem)_auto] md:px-6">
    <Link
      unstyled
      class="col-start-1 row-start-1 flex items-center gap-2 justify-self-start rounded-sm text-xl font-bold transition-colors hover:text-[var(--primary)] focus-visible:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] motion-reduce:transition-none"
      aria-label="AppHub home"
      href="/">
      <Image src={logo} alt="" width={32} height={32} loading="eager" fetchpriority="high" />
      <span>AppHub</span>
    </Link>
    <div class="col-start-2 row-start-1 flex items-center gap-2 md:hidden">
      <ThemeSelect id="mobile-theme" />
      <details class="group" data-mobile-menu>
        <summary
          class="relative flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--control-bg)] hover:border-[var(--primary)] hover:bg-[var(--card-raised)] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] [&::-webkit-details-marker]:hidden"
          data-mobile-menu-summary
          aria-label="Main menu">
          <svg
            class="absolute transition-[opacity,transform] duration-150 group-open:rotate-90 group-open:opacity-0 motion-reduce:transition-none"
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="absolute -rotate-90 opacity-0 transition-[opacity,transform] duration-150 group-open:rotate-0 group-open:opacity-100 motion-reduce:transition-none"
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <nav
          class="absolute top-full right-0 left-0 border-t border-[var(--border)] bg-[var(--page)] shadow-lg"
          data-mobile-menu-content
          aria-label="Main navigation">
          <div class="mx-auto grid max-w-6xl gap-1 px-4 py-3">
            {
              links.map(({ href, label, current }) => (
                <Link
                  class="aria-[current=page]:bg-accent/10 flex min-h-11 items-center rounded-lg border-0 px-3 py-2.5 font-medium"
                  href={href}
                  aria-current={current ? "page" : undefined}>
                  {label}
                </Link>
              ))
            }
          </div>
        </nav>
      </details>
    </div>
    <form
      class="col-span-2 col-start-1 row-start-2 w-full md:col-span-1 md:col-start-2 md:row-start-1"
      action={sitePath("/apps/")}
      method="get"
      role="search"
      hidden
      data-catalog-search>
      <label class="sr-only" for="catalog-search">Search apps</label>
      <input
        class="min-h-10 w-full rounded-lg border border-[var(--border)] bg-[var(--control-bg)] px-3 py-2 outline-none focus-visible:border-[var(--primary)] focus-visible:ring-2 focus-visible:ring-[color-mix(in_srgb,var(--primary)_20%,transparent)]"
        id="catalog-search"
        type="search"
        name="q"
        placeholder="Search apps"
        autocomplete="off"
        data-catalog-search-input
      />
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav
      class="col-start-3 row-start-1 hidden items-center justify-end gap-x-4 text-sm md:flex"
      aria-label="Main navigation">
      {
        links.map(({ href, label, current }) => (
          <Link href={href} aria-current={current ? "page" : undefined}>
            {label}
          </Link>
        ))
      }
      <ThemeSelect id="desktop-theme" />
    </nav>
  </div>
</header>

<script>
  function initializeMobileMenu() {
    const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
    const summary = menu?.querySelector<HTMLElement>("[data-mobile-menu-summary]");
    const content = menu?.querySelector<HTMLElement>("[data-mobile-menu-content]");
    if (!menu || !summary || !content || menu.dataset.initialized) {
      return;
    }

    menu.dataset.initialized = "true";
    const duration = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 150;

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      if (!menu.open) {
        menu.open = true;
        content.animate(
          [
            { opacity: 0, transform: "translateY(-0.5rem)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          { duration, easing: "ease-out" }
        );
        return;
      }

      const animation = content.animate(
        [
          { opacity: 1, transform: "translateY(0)" },
          { opacity: 0, transform: "translateY(-0.5rem)" },
        ],
        { duration, easing: "ease-in" }
      );
      animation.finished.then(() => menu.removeAttribute("open"));
    });
  }

  function showHeaderSearch() {
    const search = document.querySelector<HTMLFormElement>("[data-catalog-search]");
    if (search) {
      search.hidden = false;
    }
  }

  document.addEventListener("astro:page-load", () => {
    showHeaderSearch();
    initializeMobileMenu();
  });
</script>
