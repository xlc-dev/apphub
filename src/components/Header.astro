---
import Link from "@/components/ui/Link.astro";
import { Image } from "astro:assets";

const path = Astro.url.pathname;
---

<header
  class="relative top-0 z-50 w-full border-b border-zinc-200/80 bg-white/90 shadow-sm shadow-zinc-950/5 backdrop-blur-md md:sticky dark:border-zinc-800/80 dark:bg-zinc-950/90 dark:shadow-black/20">
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-[1fr_auto] items-center gap-4 px-4 py-4 md:grid-cols-[auto_minmax(12rem,32rem)_auto] md:px-6">
    <a
      class="col-start-1 row-start-1 flex items-center gap-2 justify-self-start rounded-sm text-xl font-bold focus-visible:outline-2 focus-visible:outline-offset-2"
      aria-label="AppHub home"
      href="/">
      <Image
        src="/favicon.svg"
        alt=""
        width={32}
        height={32}
        loading="eager"
        fetchpriority="high"
      />
      <span class="hidden sm:inline">AppHub</span>
    </a>
    <form
      class="col-span-2 col-start-1 row-start-2 w-full md:col-span-1 md:col-start-2 md:row-start-1"
      action="/"
      method="get"
      role="search"
      hidden
      data-catalog-search>
      <label class="sr-only" for="catalog-search">Search apps</label>
      <input
        class="min-h-11 w-full rounded-lg border border-zinc-300 bg-transparent px-3 py-2 outline-none focus-visible:border-zinc-950 focus-visible:ring-2 focus-visible:ring-zinc-950/20 dark:border-zinc-700 dark:bg-zinc-800 dark:focus-visible:border-zinc-50 dark:focus-visible:ring-zinc-50/20"
        id="catalog-search"
        type="search"
        name="q"
        placeholder="Search apps"
        autocomplete="off"
        data-catalog-search-input
      />
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav
      class="col-span-2 col-start-1 row-start-3 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm md:col-span-1 md:col-start-3 md:row-start-1 md:justify-end md:text-base"
      aria-label="Main navigation">
      <Link href="/" aria-current={path === "/" ? "page" : undefined}>Home</Link>
      <Link href="/categories/" aria-current={path.startsWith("/categories/") ? "page" : undefined}
        >Categories</Link
      >
      <Link href="/trending/" aria-current={path.startsWith("/trending/") ? "page" : undefined}
        >Trending</Link
      >
    </nav>
  </div>
</header>

<script>
  function showHeaderSearch() {
    const search = document.querySelector<HTMLFormElement>("[data-catalog-search]");
    if (search) search.hidden = false;
  }

  document.addEventListener("astro:page-load", showHeaderSearch);
</script>
