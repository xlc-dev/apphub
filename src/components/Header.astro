---
import Link from "@/components/ui/Link.astro";
import Icon from "@/components/Icon.astro";
import ThemeSelect from "@/components/ThemeSelect.astro";
import { getLocale, localePath, stripLocale, translate } from "@/lib/i18n";
import { routePath, sitePath } from "@/lib/paths";
import { Image } from "astro:assets";

const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
const path = stripLocale(routePath(Astro.url.pathname));
const logo = sitePath("/logo.svg");
const links = [
  {
    href: "/apps/",
    label: t("nav.apps"),
    current: path.startsWith("/apps/") || path.startsWith("/categories/"),
  },
  { href: "/new/", label: t("nav.new"), current: path.startsWith("/new/") },
  { href: "/updated/", label: t("nav.updated"), current: path.startsWith("/updated/") },
  { href: "/trending/", label: t("nav.trending"), current: path.startsWith("/trending/") },
];
---

<header
  data-app-header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--page)_90%,transparent)] shadow-sm backdrop-blur-md">
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto] items-center gap-4 px-4 py-3 md:grid-cols-[auto_minmax(12rem,32rem)_auto] md:px-6">
    <Link
      unstyled
      class="col-start-1 row-start-1 flex items-center gap-2 justify-self-start rounded-sm text-xl font-bold transition-colors hover:text-[var(--primary)] focus-visible:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] motion-reduce:transition-none"
      aria-label={t("nav.home")}
      href="/">
      <Image src={logo} alt="" width={32} height={32} loading="eager" fetchpriority="high" />
      <span>AppHub</span>
    </Link>
    <div class="col-start-2 row-start-1 flex items-center gap-2 md:hidden">
      <ThemeSelect />
      <details class="group">
        <summary
          class="relative flex size-11 cursor-pointer list-none items-center justify-center rounded-md border border-[var(--border)] bg-[var(--control-bg)] shadow-sm hover:bg-[var(--card-raised)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] [&::-webkit-details-marker]:hidden"
          aria-label={t("nav.menu")}>
          <Icon
            name="menu"
            class="absolute size-6 transition-[opacity,transform] duration-150 group-open:rotate-90 group-open:opacity-0 motion-reduce:transition-none"
          />
          <Icon
            name="close"
            class="absolute size-6 -rotate-90 opacity-0 transition-[opacity,transform] duration-150 group-open:rotate-0 group-open:opacity-100 motion-reduce:transition-none"
          />
        </summary>
        <nav
          class="absolute top-full right-0 left-0 border-t border-[var(--border)] bg-[var(--page)] shadow-lg"
          aria-label={t("nav.main")}
          data-dropdown-panel>
          <div class="mx-auto grid max-w-6xl gap-1 px-4 py-3">
            {
              links.map(({ href, label, current }) => (
                <Link
                  class="aria-[current=page]:bg-accent/10 flex min-h-11 items-center rounded-lg px-3 py-2.5 font-medium"
                  href={href}
                  aria-current={current ? "page" : undefined}>
                  {label}
                </Link>
              ))
            }
          </div>
        </nav>
      </details>
    </div>
    <form
      class="invisible col-span-2 col-start-1 row-start-2 w-full md:col-span-1 md:col-start-2 md:row-start-1"
      action={sitePath(localePath("/apps/", locale))}
      method="get"
      role="search"
      inert
      aria-hidden="true"
      data-catalog-search>
      <label class="sr-only" for="catalog-search">{t("search.label")}</label>
      <input
        class="min-h-11 w-full rounded-md border border-[var(--border)] bg-[var(--control-bg)] px-3 py-1 text-sm shadow-sm outline-none placeholder:text-[var(--muted)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
        id="catalog-search"
        type="search"
        name="q"
        placeholder={t("search.placeholder")}
        autocomplete="off"
        data-catalog-search-input
      />
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav
      class="col-start-3 row-start-1 hidden items-center justify-end gap-x-4 text-sm md:flex"
      aria-label={t("nav.main")}>
      {
        links.map(({ href, label, current }) => (
          <Link href={href} aria-current={current ? "page" : undefined}>
            {label}
          </Link>
        ))
      }
      <ThemeSelect />
    </nav>
  </div>
</header>

<script>
  function showHeaderSearch() {
    const search = document.querySelector<HTMLFormElement>("[data-catalog-search]");
    if (search) {
      search.classList.remove("invisible");
      search.inert = false;
      search.removeAttribute("aria-hidden");
    }
  }

  showHeaderSearch();
</script>
