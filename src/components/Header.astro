---
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import ThemeSelect from "@/components/ThemeSelect.astro";
import { routePath, sitePath } from "@/lib/paths";
import { Image } from "astro:assets";

const path = routePath(Astro.url.pathname);
const logo = sitePath("/logo.svg");
const links = [
  { href: "/apps/", label: "Apps", current: path === "/apps/" },
  { href: "/new/", label: "New", current: path === "/new/" },
  { href: "/trending/", label: "Trending", current: path.startsWith("/trending/") },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--page)_90%,transparent)] shadow-sm backdrop-blur-md">
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto] items-center gap-4 px-4 py-3 md:grid-cols-[auto_minmax(12rem,32rem)_auto] md:px-6">
    <Link
      unstyled
      class="col-start-1 row-start-1 flex items-center gap-2 justify-self-start rounded-sm text-xl font-bold transition-colors hover:text-[var(--primary)] focus-visible:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] motion-reduce:transition-none"
      aria-label="AppHub home"
      href="/">
      <Image src={logo} alt="" width={32} height={32} loading="eager" fetchpriority="high" />
      <span>AppHub</span>
    </Link>
    <div class="col-start-2 row-start-1 flex items-center gap-2 md:hidden">
      <ThemeSelect id="mobile-theme" />
      <Button
        icon
        class="group flex"
        aria-label="Main menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle>
        <svg
          class="group-aria-expanded:hidden"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="hidden group-aria-expanded:block"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </Button>
      <nav
        class="invisible absolute top-full right-0 left-0 grid grid-rows-[0fr] border-t border-[var(--border)] bg-[var(--page)] opacity-0 shadow-lg transition-[grid-template-rows,opacity,visibility] duration-200 data-[open]:visible data-[open]:grid-rows-[1fr] data-[open]:opacity-100 motion-reduce:transition-none"
        id="mobile-navigation"
        aria-label="Main navigation"
        aria-hidden="true"
        inert
        data-mobile-navigation>
        <div class="overflow-hidden">
          <div class="mx-auto grid max-w-6xl gap-1 px-4 py-3">
            {
              links.map(({ href, label, current }) => (
                <Link
                  class="aria-[current=page]:bg-accent/10 flex min-h-11 items-center rounded-lg border-0 px-3 py-2.5 font-medium"
                  href={href}
                  aria-current={current ? "page" : undefined}>
                  {label}
                </Link>
              ))
            }
          </div>
        </div>
      </nav>
    </div>
    <form
      class="col-span-2 col-start-1 row-start-2 w-full md:col-span-1 md:col-start-2 md:row-start-1"
      action={sitePath("/apps/")}
      method="get"
      role="search"
      hidden
      data-catalog-search>
      <label class="sr-only" for="catalog-search">Search apps</label>
      <input
        class="min-h-10 w-full rounded-lg border border-[var(--border)] bg-[var(--control-bg)] px-3 py-2 outline-none focus-visible:border-[var(--primary)] focus-visible:ring-2 focus-visible:ring-[color-mix(in_srgb,var(--primary)_20%,transparent)]"
        id="catalog-search"
        type="search"
        name="q"
        placeholder="Search apps"
        autocomplete="off"
        data-catalog-search-input
      />
      <p class="sr-only" aria-live="polite" data-search-status></p>
    </form>
    <nav
      class="col-start-3 row-start-1 hidden items-center justify-end gap-x-4 text-sm md:flex"
      aria-label="Main navigation">
      {
        links.map(({ href, label, current }) => (
          <Link href={href} aria-current={current ? "page" : undefined}>
            {label}
          </Link>
        ))
      }
      <ThemeSelect id="desktop-theme" />
    </nav>
  </div>
</header>

<script>
  function initMobileNavigation() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const navigation = document.querySelector<HTMLElement>("[data-mobile-navigation]");
    if (!toggle || !navigation || toggle.dataset.initialized) return;

    toggle.dataset.initialized = "true";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      navigation.toggleAttribute("data-open", open);
      navigation.setAttribute("aria-hidden", String(!open));
      navigation.inert = !open;
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true")
    );
    toggle.parentElement?.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  function showHeaderSearch() {
    const search = document.querySelector<HTMLFormElement>("[data-catalog-search]");
    if (search) search.hidden = false;
  }

  document.addEventListener("astro:page-load", () => {
    showHeaderSearch();
    initMobileNavigation();
  });
</script>
