---
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import { Image } from "astro:assets";

interface Props {
  label: string;
  screenshots: Array<{
    url: string;
    caption: string;
  }>;
}

const { label, screenshots } = Astro.props;
const id = `${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-carousel`;
---

<Section
  spaced={false}
  title={label}
  headingId={`${id}-heading`}
  aria-labelledby={`${id}-heading`}
  aria-roledescription="carousel"
  role="region"
  data-carousel>
  <Button
    icon
    slot="actions"
    class="hidden size-11 shrink-0"
    aria-label="Enlarge screenshots"
    aria-expanded="false"
    data-carousel-fullscreen>
    <svg
      data-carousel-expand-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-5"
      fill="none"
      stroke="currentColor"
      stroke-width="2">
      <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
    </svg>
    <svg
      class="hidden size-5"
      data-carousel-close-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2">
      <path d="m6 6 12 12M18 6 6 18"></path>
    </svg>
  </Button>
  <div
    class="relative grid grid-cols-[minmax(0,1fr)] items-center sm:grid-cols-[2.75rem_minmax(0,1fr)_2.75rem] sm:gap-3"
    data-carousel-frame>
    <div
      class="col-start-1 row-start-1 flex aspect-video snap-x snap-mandatory items-center overflow-x-auto overscroll-x-contain scroll-smooth rounded-xl motion-reduce:scroll-auto sm:col-start-2"
      aria-live="polite"
      data-carousel-track>
      {
        screenshots.map((screenshot, index) => (
          <figure
            class="m-0 flex h-full w-full shrink-0 snap-center flex-col items-center justify-center"
            id={`${id}-${index + 1}`}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${screenshots.length}`}
            data-carousel-slide>
            <Image
              class="block max-h-full min-h-0 max-w-full rounded-xl object-contain"
              src={screenshot.url}
              alt=""
              width={1920}
              height={1080}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
            />
            <figcaption class="mt-2">{screenshot.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    {
      screenshots.length > 1 && (
        <>
          <Button
            icon
            class="absolute top-1/2 left-2 z-10 hidden size-11 -translate-y-1/2 rounded-full sm:static sm:col-start-1 sm:row-start-1 sm:translate-y-0"
            aria-label="Previous screenshot"
            data-carousel-previous>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </Button>
          <Button
            icon
            class="absolute top-1/2 right-2 z-10 hidden size-11 -translate-y-1/2 rounded-full sm:static sm:col-start-3 sm:row-start-1 sm:translate-y-0"
            aria-label="Next screenshot"
            data-carousel-next>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </Button>
        </>
      )
    }
  </div>

  {
    screenshots.length > 1 && (
      <div class="mt-2 flex min-h-11 items-center justify-center">
        <nav class="flex" aria-label="Choose screenshot">
          {screenshots.map((_, index) => (
            <a
              class="group flex size-8 cursor-pointer items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-[-0.25rem]"
              href={`#${id}-${index + 1}`}
              aria-label={`Show screenshot ${index + 1} of ${screenshots.length}`}
              aria-current={index === 0 ? "true" : undefined}
              data-carousel-dot>
              <span
                class="size-2.5 rounded-full bg-[var(--border)] group-hover:bg-[var(--primary)] group-aria-[current=true]:bg-[var(--primary)]"
                aria-hidden="true"
              />
            </a>
          ))}
        </nav>
      </div>
    )
  }
</Section>

<script>
  import { currentSlide, markCurrentSlide, showSlide } from "@/lib/carousel";

  function initializeCarousels() {
    for (const carousel of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
      if (carousel.dataset.initialized) {
        continue;
      }

      const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
      const dots = Array.from(carousel.querySelectorAll<HTMLAnchorElement>("[data-carousel-dot]"));
      const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-previous]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const fullscreen = carousel.querySelector<HTMLButtonElement>("[data-carousel-fullscreen]");

      if (!track || !fullscreen) {
        continue;
      }

      carousel.dataset.initialized = "true";
      previous?.classList.replace("hidden", "flex");
      next?.classList.replace("hidden", "flex");
      fullscreen.classList.replace("hidden", "flex");

      let current = 0;
      const events = new AbortController();

      const update = () => {
        current = currentSlide(track, slides);
        markCurrentSlide(dots, current);
      };

      const setExpanded = (expanded: boolean) => {
        carousel.toggleAttribute("data-carousel-expanded", expanded);
        carousel.setAttribute("role", expanded ? "dialog" : "region");
        carousel.toggleAttribute("aria-modal", expanded);
        document.body.classList.toggle("overflow-hidden", expanded);
        fullscreen.setAttribute("aria-expanded", String(expanded));
        fullscreen.setAttribute(
          "aria-label",
          expanded ? "Close enlarged screenshots" : "Enlarge screenshots"
        );
      };

      previous?.addEventListener("click", () => {
        showSlide(slides, current - 1);
      });
      next?.addEventListener("click", () => {
        showSlide(slides, current + 1);
      });
      dots.forEach((dot, index) =>
        dot.addEventListener("click", (event) => {
          event.preventDefault();
          showSlide(slides, index);
        })
      );
      fullscreen.addEventListener("click", () => {
        setExpanded(!carousel.hasAttribute("data-carousel-expanded"));
      });
      track.addEventListener("scrollend", update);
      track.addEventListener("scroll", update, { passive: true });
      document.addEventListener(
        "keydown",
        (event) => {
          if (!carousel.hasAttribute("data-carousel-expanded")) {
            return;
          }

          if (event.key === "Tab") {
            const controls = Array.from(
              carousel.querySelectorAll<HTMLElement>("button, a[href]")
            ).filter((control) => !control.hidden);
            const first = controls[0];
            const last = controls.at(-1);

            if (!carousel.contains(document.activeElement)) {
              event.preventDefault();
              (event.shiftKey ? last : first)?.focus();
            } else if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last?.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first?.focus();
            }

            return;
          }

          if (event.key !== "Escape") {
            return;
          }

          setExpanded(false);
          fullscreen.focus();
        },
        { signal: events.signal }
      );
      document.addEventListener(
        "astro:before-swap",
        () => {
          setExpanded(false);
          events.abort();
        },
        { once: true }
      );
      update();
    }
  }

  document.addEventListener("astro:page-load", initializeCarousels);
</script>

<style>
  [data-carousel-track] {
    scrollbar-width: none;
  }

  [data-carousel-track]::-webkit-scrollbar {
    display: none;
  }

  [data-carousel-dot][aria-current="true"] span {
    background: currentColor;
  }

  [data-carousel-expanded] {
    position: fixed;
    inset: 0;
    z-index: 100;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: var(--color-foreground);
    color: var(--color-surface);
  }

  :global(body:has([data-carousel-expanded]) main) {
    z-index: 60;
  }

  @media (prefers-color-scheme: dark) {
    [data-carousel-expanded] {
      background: var(--color-canvas);
      color: var(--color-foreground);
    }
  }

  [data-carousel-expanded] [data-carousel-frame] {
    min-height: 0;
    flex: 1;
  }

  [data-carousel-expanded] [data-carousel-track] {
    height: 100%;
    aspect-ratio: auto;
  }

  [data-carousel-expanded] [data-carousel-slide] {
    height: 100%;
  }

  [data-carousel-expanded] [data-carousel-expand-icon] {
    display: none;
  }

  [data-carousel-expanded] [data-carousel-close-icon] {
    display: block;
  }
</style>
