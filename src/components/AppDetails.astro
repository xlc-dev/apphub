---
import type { ApiApp } from "@/lib/api";
import Link from "@/components/ui/Link.astro";

interface Props {
  app: ApiApp;
}

const { app } = Astro.props;
const website = new URL(app.homepage);
const websiteLabel = website.hostname.replace(/^www\./, "") || app.homepage;
const repository = app.repository && new URL(app.repository);
const repositoryLabel =
  repository &&
  (repository.hostname.replace(/^www\./, "") + repository.pathname).replace(/\/$/, "");
---

<aside
  class="dark:border-control self-start rounded-xl border border-zinc-200 p-5"
  aria-labelledby="details-heading">
  <h2 class="m-0 text-xl font-bold" id="details-heading">Details</h2>
  <dl class="mb-0 grid gap-4">
    {
      app.health && (
        <div>
          <dt class="text-sm text-zinc-500 dark:text-zinc-400">Availability</dt>
          <dd class="m-0 mt-1 capitalize">{app.health.status}</dd>
        </div>
      )
    }
    <div>
      <dt class="text-sm text-zinc-500 dark:text-zinc-400">Developer</dt>
      <dd class="m-0 mt-1">
        {
          app.developer.url ? (
            <Link href={app.developer.url}>{app.developer.name}</Link>
          ) : (
            app.developer.name
          )
        }
      </dd>
    </div>
    <div>
      <dt class="text-sm text-zinc-500 dark:text-zinc-400">License</dt>
      <dd class="m-0 mt-1">{app.projectLicense}</dd>
    </div>
    <div>
      <dt class="text-sm text-zinc-500 dark:text-zinc-400">Website</dt>
      <dd class="m-0 mt-1 break-words">
        <Link href={app.homepage}>{websiteLabel}</Link>
      </dd>
    </div>
    {
      app.repository && (
        <div>
          <dt class="text-sm text-zinc-500 dark:text-zinc-400">Repository</dt>
          <dd class="m-0 mt-1 break-words">
            <Link href={app.repository}>{repositoryLabel}</Link>
          </dd>
        </div>
      )
    }
  </dl>
</aside>
