---
import type { ApiApp } from "@/lib/api";
import Link from "@/components/ui/Link.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  app: ApiApp;
  downloads?: number | undefined;
  stars?: number | undefined;
}

const { app, downloads, stars } = Astro.props;
const website = new URL(app.homepage);
const websiteLabel = website.hostname.replace(/^www\./, "") || app.homepage;
const repository = app.repository && new URL(app.repository);
const repositoryLabel =
  repository &&
  (repository.hostname.replace(/^www\./, "") + repository.pathname).replace(/\/$/, "");
const linkLabels = {
  bugtracker: "Report an issue",
  help: "Help",
  contact: "Contact",
  translate: "Translate",
  contribute: "Contribute",
  faq: "FAQ",
};
const projectLinks = Object.entries(app.links ?? {}).filter(([type]) => type !== "donation");
const rawWarnings = Object.entries(app.contentRating?.attributes ?? {})
  .filter(([, level]) => level !== "none")
  .map(
    ([name, level]) =>
      `${name.replaceAll("-", " ").replace(/^./, (character) => character.toUpperCase())}: ${level}`
  );
const contentWarnings = app.contentRating?.warnings ?? rawWarnings;
---

<aside
  class="self-start overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-sm"
  aria-labelledby="details-heading">
  <div class="border-b border-[var(--border)] bg-[var(--card-raised)] px-5 py-4">
    <h2 class="m-0 text-xl font-bold" id="details-heading">Details</h2>
  </div>
  <dl class="m-0 divide-y divide-[var(--border)]">
    <div class="px-5 py-3.5">
      <dt class="text-sm text-[var(--muted)]">Developer</dt>
      <dd class="m-0 mt-1">
        {
          app.developer.url ? (
            <Link href={app.developer.url}>{app.developer.name}</Link>
          ) : (
            app.developer.name
          )
        }
      </dd>
    </div>
    {
      downloads !== undefined && (
        <div class="px-5 py-3.5">
          <dt class="text-sm text-[var(--muted)]">Total downloads</dt>
          <dd class="m-0 mt-1 font-medium tabular-nums">{downloads.toLocaleString("en")}</dd>
        </div>
      )
    }
    <div class="px-5 py-3.5">
      <dt class="text-sm text-[var(--muted)]">Website</dt>
      <dd class="m-0 mt-1 break-words">
        <Link href={app.homepage}>{websiteLabel}</Link>
      </dd>
    </div>
    {
      app.repository && (
        <div class="px-5 py-3.5">
          <dt class="text-sm text-[var(--muted)]">Repository</dt>
          <dd class="m-0 mt-1 break-words">
            <Link href={app.repository}>{repositoryLabel}</Link>
            {stars !== undefined && (
              <span
                class="mt-2 flex items-center gap-1.5 text-sm text-[var(--muted)]"
                aria-label={`${stars.toLocaleString("en")} repository stars`}>
                <Icon name="star" class="size-4" />
                {stars.toLocaleString("en")}
              </span>
            )}
          </dd>
        </div>
      )
    }
    {
      projectLinks.length > 0 && (
        <div class="px-5 py-3.5">
          <dt class="text-sm text-[var(--muted)]">Resources</dt>
          <dd class="m-0 mt-2">
            <ul class="m-0 list-none divide-y divide-[var(--border)] overflow-hidden rounded-lg border border-[var(--border)] p-0">
              {projectLinks.map(([type, url]) => (
                <li>
                  <Link
                    unstyled
                    class="flex min-h-11 items-center justify-between gap-3 bg-[var(--control-bg)] px-3 text-sm hover:bg-[var(--card-raised)] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--primary)]"
                    href={url}>
                    {linkLabels[type as keyof typeof linkLabels]}
                    <Icon name="external" class="size-4 text-[var(--muted)]" />
                  </Link>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
    {
      contentWarnings.length > 0 && (
        <div class="px-5 py-3.5">
          <dt class="text-sm text-[var(--muted)]">Content notes</dt>
          <dd class="m-0 mt-1">
            <ul class="m-0 space-y-1 pl-5 text-sm text-[var(--muted)]">
              {contentWarnings.map((warning) => (
                <li>{warning}</li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
</aside>
