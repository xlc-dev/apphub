---
import type { ApiApp } from "@/lib/api";
import Link from "@/components/ui/Link.astro";

interface Props {
  app: ApiApp;
}

const { app } = Astro.props;
const sourceRepository =
  app.releaseSource.type === "github" ? app.releaseSource.repository : undefined;
const repository = sourceRepository ? `https://github.com/${sourceRepository}` : undefined;
const website = app.homepage && new URL(app.homepage);
const websiteLabel = website && (website.hostname.replace(/^www\./, "") || app.homepage);
---

<aside
  class="dark:border-control self-start rounded-xl border border-zinc-200 p-5"
  aria-labelledby="details-heading">
  <h2 class="m-0 text-xl font-bold" id="details-heading">Details</h2>
  <dl class="mb-0 grid gap-4">
    {
      app.health && (
        <div>
          <dt class="text-sm text-zinc-500 dark:text-zinc-400">Availability</dt>
          <dd class="m-0 mt-1 capitalize">{app.health.status}</dd>
        </div>
      )
    }
    {
      app.license && (
        <div>
          <dt class="text-sm text-zinc-500 dark:text-zinc-400">License</dt>
          <dd class="m-0 mt-1">{app.license}</dd>
        </div>
      )
    }
    {
      app.homepage && (
        <div>
          <dt class="text-sm text-zinc-500 dark:text-zinc-400">Website</dt>
          <dd class="m-0 mt-1 break-words">
            <Link href={app.homepage}>{websiteLabel}</Link>
          </dd>
        </div>
      )
    }
    {
      repository && (
        <div>
          <dt class="text-sm text-zinc-500 dark:text-zinc-400">Repository</dt>
          <dd class="m-0 mt-1 break-words">
            <Link href={repository}>{sourceRepository}</Link>
          </dd>
        </div>
      )
    }
  </dl>
</aside>
