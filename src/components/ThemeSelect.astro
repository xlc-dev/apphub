---
import { getLocale, translate } from "@/lib/i18n";
import Icon from "@/components/Icon.astro";
import type { ThemeMode } from "@/lib/theme";

interface Props {
  id: string;
}

const { id } = Astro.props;
const modes: ThemeMode[] = ["system", "light", "dark"];
const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
const labels = { system: t("theme.system"), light: t("theme.light"), dark: t("theme.dark") };
const icons = {
  system: "theme-system",
  light: "theme-light",
  dark: "theme-dark",
} as const;
---

<details class="relative" data-theme-menu>
  <summary
    class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md border border-[var(--border)] bg-[var(--control-bg)] shadow-sm hover:bg-[var(--card-raised)] focus-visible:border-[var(--primary)] focus-visible:ring-[3px] focus-visible:ring-[color-mix(in_srgb,var(--primary)_20%,transparent)] focus-visible:outline-none [&::-webkit-details-marker]:hidden"
    aria-label={t("theme.label")}
    title={t("theme.label")}
    data-theme-summary>
    {
      modes.map((mode) => (
        <Icon
          name={icons[mode]}
          class:list={["size-5", mode !== "system" && "hidden"]}
          data-theme-current={mode}
        />
      ))
    }
  </summary>
  <div
    class="absolute right-0 z-50 mt-2 w-40 rounded-md border border-[var(--border)] bg-[var(--card)] p-1 shadow-lg"
    id={id}
    role="menu"
    aria-label={t("theme.label")}>
    {
      modes.map((mode) => (
        <button
          class="flex min-h-11 w-full cursor-pointer items-center gap-2 rounded-sm px-2 text-left text-sm hover:bg-[var(--card-raised)] focus-visible:bg-[var(--card-raised)] focus-visible:outline-none aria-[checked=true]:bg-[var(--card-raised)]"
          type="button"
          role="menuitemradio"
          aria-checked="false"
          data-theme-option={mode}>
          <Icon name={icons[mode]} class="size-4" />
          <span class="grow">{labels[mode]}</span>
          <Icon name="check" class="invisible size-4" data-theme-check />
        </button>
      ))
    }
  </div>
</details>

<script>
  import { parseThemeMode, resolveTheme, type ThemeMode } from "@/lib/theme";

  function initializeThemeMenus() {
    const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-theme-menu]"));

    if (!menus.length || menus.every((menu) => menu.dataset.initialized)) return;

    const options = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-option]"));
    const media = matchMedia("(prefers-color-scheme: dark)");

    const apply = (mode: ThemeMode, save: boolean) => {
      const theme = resolveTheme(mode, media.matches);

      document.documentElement.dataset.themeMode = mode;
      document.documentElement.dataset.theme = theme;
      document
        .querySelector("[data-theme-color]")
        ?.setAttribute("content", theme === "dark" ? "#1e1e1e" : "#fafafa");

      menus.forEach((menu) =>
        menu
          .querySelectorAll<HTMLElement>("[data-theme-current]")
          .forEach((icon) => icon.classList.toggle("hidden", icon.dataset.themeCurrent !== mode))
      );
      options.forEach((option) => {
        const selected = option.dataset.themeOption === mode;

        option.setAttribute("aria-checked", String(selected));
        option
          .querySelector<HTMLElement>("[data-theme-check]")
          ?.classList.toggle("invisible", !selected);
      });

      if (save) {
        try {
          localStorage.setItem("apphub-theme", mode);
        } catch {}
      }
    };

    let stored: string | null = null;

    try {
      stored = localStorage.getItem("apphub-theme");
    } catch {}

    apply(parseThemeMode(stored), false);

    menus.forEach((menu) => (menu.dataset.initialized = "true"));

    options.forEach((option) => {
      option.addEventListener("click", () => {
        apply(parseThemeMode(option.dataset.themeOption ?? null), true);
        option.closest<HTMLDetailsElement>("[data-theme-menu]")?.removeAttribute("open");
      });
    });

    menus.forEach((menu) => {
      menu.addEventListener("keydown", (event) => {
        const items = Array.from(menu.querySelectorAll<HTMLButtonElement>("[data-theme-option]"));
        const current = items.indexOf(document.activeElement as HTMLButtonElement);
        const next =
          event.key === "ArrowDown"
            ? current + 1
            : event.key === "ArrowUp"
              ? current - 1
              : undefined;

        if (next !== undefined) {
          event.preventDefault();
          items[(next + items.length) % items.length]?.focus();
        } else if (event.key === "Escape") {
          menu.removeAttribute("open");
          menu.querySelector<HTMLElement>("[data-theme-summary]")?.focus();
        }
      });
    });

    document.addEventListener("click", (event) => {
      menus.forEach((menu) => {
        if (!menu.contains(event.target as Node)) menu.removeAttribute("open");
      });
    });

    media.addEventListener("change", () => {
      if (document.documentElement.dataset.themeMode === "system") apply("system", false);
    });
  }

  initializeThemeMenus();
</script>
