---
interface Props {
  name: "age-rating" | "category" | "community" | "donate" | "external" | "license" | "official";
  class?: string;
}

const { name, class: className } = Astro.props;
const icons = {
  "age-rating": "/icons/age-rating.svg",
  category: "/icons/category.svg",
  community: "/icons/community.svg",
  donate: "/icons/donate.svg",
  external: "/icons/external.svg",
  license: "/icons/license.svg",
  official: "/icons/official.svg",
};
const mask = `url(${icons[name]}) center / contain no-repeat`;
---

<span
  class:list={["inline-block shrink-0 bg-current", className]}
  style={`mask: ${mask}; -webkit-mask: ${mask}`}
  aria-hidden="true"></span>
