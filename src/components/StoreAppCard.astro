---
import type { ApiApp } from "@/lib/api";
import SourceBadge from "@/components/SourceBadge.astro";
import Link from "@/components/ui/Link.astro";
import { Image } from "astro:assets";

interface Props {
  app: ApiApp;
  detail?: string;
  priority?: boolean;
}

const { app, detail, priority = false } = Astro.props;
---

<article class="min-w-0">
  <Link
    unstyled
    class="dark:border-control dark:hover:bg-surface-raised group flex h-full gap-4 rounded-xl border border-zinc-200 p-4 hover:bg-zinc-50 focus-visible:outline-2 focus-visible:outline-offset-2"
    href={`/apps/${app.slug}/`}>
    <Image
      class="size-16 shrink-0 rounded-xl"
      src={app.icon.url}
      alt=""
      width={64}
      height={64}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <h3
          class="truncate font-semibold group-hover:text-zinc-600 dark:group-hover:text-zinc-300">
          {app.name}
        </h3>
        <SourceBadge source={app.source} />
      </div>
      <p class="mt-1 line-clamp-2 text-sm leading-5 text-zinc-600 dark:text-zinc-400">
        {app.summary}
      </p>
      {detail && <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-500">{detail}</p>}
    </div>
  </Link>
</article>
