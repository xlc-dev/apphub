---
import Icon from "@/components/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { getLocale, translate } from "@/lib/i18n";

interface FilterOption {
  id: string;
  label: string;
  count: number;
}

interface FilterGroup {
  name?: string;
  parameter: string;
  options: FilterOption[];
}

interface FilterMenu {
  name: string;
  groups: FilterGroup[];
}

interface Props {
  menus: FilterMenu[];
  total: number;
}

const { menus, total } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
---

<div
  class="invisible relative grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]"
  inert
  aria-hidden="true"
  data-catalog-filter-controls>
  <div class="flex flex-wrap gap-2">
    {
      menus.map(({ name, groups }) => (
        <details class="group static sm:relative" data-filter-menu>
          <summary class="relative flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-md border border-[var(--border)] bg-[var(--control-bg)] px-3 text-sm font-medium shadow-sm hover:bg-[var(--card-raised)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] [&::-webkit-details-marker]:hidden">
            {name}
            <span
              class="invisible absolute -top-1.5 -right-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-[var(--primary)] px-1 text-xs text-[var(--primary-text)]"
              data-filter-count>
              0
            </span>
            <Icon
              name="chevron-down"
              class="size-4 text-[var(--muted)] transition-transform group-open:rotate-180 motion-reduce:transition-none"
            />
          </summary>
          <div
            class="absolute right-0 left-0 z-20 mt-2 max-h-[min(32rem,70vh)] overflow-y-auto rounded-lg border border-[var(--border)] bg-[var(--card)] p-2 shadow-lg sm:right-auto sm:w-72"
            data-dropdown-panel>
            {groups.map(({ name: groupName, parameter, options }, index) => (
              <fieldset class:list={[index > 0 && "mt-2 border-t border-[var(--border)] pt-2"]}>
                {groupName && <legend class="px-2 py-1 text-sm font-semibold">{groupName}</legend>}
                {options.map(({ id, label, count }) => (
                  <label class="grid min-h-11 cursor-pointer grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 rounded-md px-2 text-sm hover:bg-[var(--card-raised)]">
                    <input
                      class="size-4 accent-[var(--primary)]"
                      type="checkbox"
                      name={parameter}
                      value={id}
                      data-catalog-filter
                    />
                    <span class="truncate">{label}</span>
                    <span class="text-right text-xs text-[var(--muted)] tabular-nums">{count}</span>
                  </label>
                ))}
              </fieldset>
            ))}
          </div>
        </details>
      ))
    }
  </div>
  <div class="flex items-center justify-between gap-2 sm:justify-end">
    <Button disabled data-clear-filters>{t("filters.clear")}</Button>
    <p class="min-w-24 text-right text-sm text-[var(--muted)]" data-visible-filter-status>
      {t(total === 1 ? "apps.appFound" : "apps.appsFound", { count: total })}
    </p>
  </div>
</div>
