---
import type { CatalogApp } from "@/lib/catalog-loader";
import Button from "@/components/ui/Button.astro";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  artifacts: CatalogApp["releases"][number]["artifacts"];
}

const artifacts = Astro.props.artifacts.map(({ architecture, sha256, url }) => ({
  architecture,
  sha256,
  url,
}));
const locale = getLocale(Astro.currentLocale);
const clientRequired = translate(locale, "install.clientRequired");
const messages = {
  install: translate(locale, "install.label"),
  unavailable: translate(locale, "install.unavailable"),
  unknown: translate(locale, "install.unknownArchitecture"),
  wrong: translate(locale, "install.wrongArchitecture"),
  missing: translate(locale, "install.noArchitecture"),
};
---

<div
  class="relative inline-flex flex-col items-start gap-2"
  hidden
  data-install
  data-artifacts={JSON.stringify(artifacts)}
  data-messages={JSON.stringify(messages)}>
  <Button large variant="primary" data-install-button>{messages.install}</Button>
  <p class="m-0 text-sm whitespace-nowrap text-[var(--muted)]" hidden data-install-client>
    {clientRequired}
  </p>
  <p class="m-0 max-w-sm text-sm text-[var(--muted)]" hidden data-install-message></p>
</div>

<script>
  import { normalizeArchitecture } from "@/lib/architecture";

  interface Artifact {
    architecture: string;
    sha256: string;
    url: string;
  }

  interface UserAgentData {
    getHighEntropyValues(hints: string[]): Promise<{ architecture?: string; bitness?: string }>;
  }

  async function deviceArchitecture() {
    const userAgentData = (navigator as Navigator & { userAgentData?: UserAgentData })
      .userAgentData;

    if (userAgentData) {
      try {
        const { architecture, bitness } = await userAgentData.getHighEntropyValues([
          "architecture",
          "bitness",
        ]);
        const normalized = normalizeArchitecture(architecture ?? "", bitness);
        if (normalized) {
          return normalized;
        }
      } catch {}
    }

    const platform = normalizeArchitecture(navigator.platform);
    if (platform) {
      return platform;
    }

    const userAgentArchitecture = navigator.userAgent.match(
      /(?:x86[_-]?64|amd64|i[3-6]86|aarch64|arm64|armv7l?|armhf|riscv64|ppc64le|s390x)/i
    )?.[0];
    return normalizeArchitecture(userAgentArchitecture ?? "");
  }

  async function initializeInstallButtons() {
    for (const install of document.querySelectorAll<HTMLElement>("[data-install]")) {
      if (install.dataset.initialized) {
        continue;
      }
      install.dataset.initialized = "true";

      const button = install.querySelector<HTMLButtonElement>("[data-install-button]");
      const client = install.querySelector<HTMLElement>("[data-install-client]");
      const message = install.querySelector<HTMLElement>("[data-install-message]");
      if (!button || !client || !message) {
        continue;
      }

      const artifacts = JSON.parse(install.dataset.artifacts ?? "[]") as Artifact[];
      const messages = JSON.parse(install.dataset.messages ?? "{}") as Record<string, string>;
      const architecture = await deviceArchitecture();
      const artifact = artifacts.find((candidate) => candidate.architecture === architecture);
      const events = new AbortController();

      if (artifact) {
        client.hidden = false;
        button.addEventListener(
          "click",
          () => {
            const url = new URL("appimg://install");
            url.searchParams.set("url", artifact.url);
            url.searchParams.set("sha256", artifact.sha256);
            window.location.href = url.href;
          },
          { signal: events.signal }
        );
      } else if (!architecture) {
        message.textContent = messages.unknown!;
      } else if (artifacts.length === 1) {
        message.textContent = messages
          .wrong!.replace("{available}", artifacts[0]!.architecture)
          .replace("{detected}", architecture);
      } else {
        message.textContent = messages.missing!.replace("{architecture}", architecture);
      }

      if (!artifact) {
        button.textContent = messages.unavailable!;
        button.disabled = true;
        button.dataset.unavailable = "";
        message.hidden = false;
      }
      install.hidden = false;
    }
  }

  initializeInstallButtons();
</script>

<style is:global>
  [data-install-button][data-unavailable] {
    border: 1px solid var(--border);
    background: var(--control-bg);
    color: var(--muted);
    box-shadow: none;
    opacity: 1;
  }
</style>
