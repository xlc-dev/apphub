---
import type { CatalogApp } from "@/lib/catalog-model";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  artifacts: CatalogApp["releases"][number]["artifacts"];
  blocked?: boolean;
}

const { blocked = false } = Astro.props;
const artifacts = Astro.props.artifacts
  .filter(({ installable }) => installable)
  .map(({ architecture, sha256, url }) => ({ architecture, sha256, url }));
const locale = getLocale(Astro.currentLocale);
const messages = {
  install: translate(locale, "install.label"),
  unknown: translate(locale, "install.unknownArchitecture"),
  mobile: translate(locale, "install.mobileUnsupported"),
  wrong: translate(locale, "install.wrongArchitecture"),
  missing: translate(locale, "install.noArchitecture"),
  blocked: translate(locale, "install.downloadsBlocked"),
  download: translate(locale, "download.label"),
};
---

<div
  class="invisible contents"
  inert
  aria-hidden="true"
  data-install
  data-blocked={blocked || undefined}
  data-artifacts={JSON.stringify(artifacts)}
  data-messages={JSON.stringify(messages)}>
  <Button
    class="col-start-1 row-start-1 justify-self-start"
    large
    variant="primary"
    data-install-button>
    {blocked ? messages.download : messages.install}
  </Button>
  <p
    class="col-span-2 col-start-1 row-start-3 m-0 max-w-full text-sm text-[var(--muted)] sm:whitespace-nowrap"
    hidden={!blocked}
    data-install-message>
    {
      blocked ? (
        messages.blocked
      ) : (
        <>
          {translate(locale, "install.nothingHappened")}{" "}
          {translate(locale, "install.compatibleClient")}{" "}
          <Link accent href="https://github.com/kem-a/AppManager">
            AppManager
          </Link>
          , {translate(locale, "install.or")}{" "}
          <Link accent href="#downloads">
            {translate(locale, "install.downloadManually")}
          </Link>
        </>
      )
    }
  </p>
</div>

<script>
  import { isMobileDevice, normalizeArchitecture } from "@/lib/architecture";

  interface Artifact {
    architecture: string;
    sha256: string;
    url: string;
  }

  interface UserAgentData {
    mobile: boolean;
    getHighEntropyValues(hints: string[]): Promise<{ architecture?: string; bitness?: string }>;
  }

  async function deviceArchitecture() {
    const userAgentData = (navigator as Navigator & { userAgentData?: UserAgentData })
      .userAgentData;

    if (userAgentData) {
      try {
        const { architecture, bitness } = await userAgentData.getHighEntropyValues([
          "architecture",
          "bitness",
        ]);
        const normalized = normalizeArchitecture(architecture ?? "", bitness);
        if (normalized) {
          return normalized;
        }
      } catch {}
    }

    const platform = normalizeArchitecture(navigator.platform);
    if (platform) {
      return platform;
    }

    const userAgentArchitecture = navigator.userAgent.match(
      /(?:x86[_-]?64|amd64|i[3-6]86|aarch64|arm64|armv7l?|armhf|riscv64|ppc64le|s390x)/i
    )?.[0];
    return normalizeArchitecture(userAgentArchitecture ?? "");
  }

  async function initializeInstallButtons() {
    for (const install of document.querySelectorAll<HTMLElement>("[data-install]")) {
      if (install.dataset.initialized) {
        continue;
      }
      install.dataset.initialized = "true";

      const button = install.querySelector<HTMLButtonElement>("[data-install-button]");
      const message = install.querySelector<HTMLElement>("[data-install-message]");
      if (!button || !message) {
        continue;
      }

      const artifacts = JSON.parse(install.dataset.artifacts ?? "[]") as Artifact[];
      const messages = JSON.parse(install.dataset.messages ?? "{}") as Record<string, string>;
      const userAgentData = (navigator as Navigator & { userAgentData?: UserAgentData })
        .userAgentData;
      const mobile = isMobileDevice(navigator.userAgent, userAgentData?.mobile);
      const architecture = mobile ? undefined : await deviceArchitecture();
      const artifact = artifacts.find((candidate) => candidate.architecture === architecture);
      const blocked = install.dataset.blocked !== undefined;
      const viewDownloads = () => document.querySelector("#downloads")?.scrollIntoView();

      if (blocked) {
        message.textContent = messages.blocked!;
      } else if (artifact) {
        button.addEventListener("click", () => {
          const url = new URL("appimg://install");
          url.searchParams.set("url", artifact.url);
          url.searchParams.set("sha256", artifact.sha256);
          window.location.href = url.href;
          message.hidden = false;
        });
      } else if (mobile) {
        message.textContent = messages.mobile!;
      } else if (!architecture) {
        message.textContent = messages.unknown!;
      } else if (artifacts.length === 1) {
        message.textContent = messages
          .wrong!.replace("{available}", artifacts[0]!.architecture)
          .replace("{detected}", architecture);
      } else {
        message.textContent = messages.missing!.replace("{architecture}", architecture);
      }

      if (blocked || !artifact) {
        button.textContent = messages.download!;
        button.addEventListener("click", viewDownloads);
        message.hidden = false;
      }
      install.classList.remove("invisible");
      install.inert = false;
      install.removeAttribute("aria-hidden");
    }
  }

  initializeInstallButtons();
</script>
