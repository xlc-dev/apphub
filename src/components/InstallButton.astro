---
import type { ApiApp } from "@/lib/api";
import Button from "@/components/ui/Button.astro";

interface Props {
  artifacts: ApiApp["releases"][number]["artifacts"];
}

const artifacts = Astro.props.artifacts.map(({ architecture, sha256, url }) => ({
  architecture,
  sha256,
  url,
}));
---

<div class="relative mt-4 inline-block" data-install data-artifacts={JSON.stringify(artifacts)}>
  <Button
    large
    variant="primary"
    class="aria-disabled:cursor-not-allowed aria-disabled:opacity-50"
    aria-disabled="true"
    aria-expanded="false"
    aria-controls="install-message"
    aria-describedby="install-message"
    data-install-button>
    Install
  </Button>
  <div
    class="m-0 w-80 max-w-[calc(100vw-2rem)] rounded-md border border-[var(--border)] bg-[var(--card)] p-4 text-sm text-[var(--foreground)] shadow-md"
    id="install-message"
    popover
    data-install-message>
    Checking your device architecture…
  </div>
</div>

<script>
  import { normalizeArchitecture } from "@/lib/architecture";

  interface Artifact {
    architecture: string;
    sha256: string;
    url: string;
  }

  interface UserAgentData {
    getHighEntropyValues(hints: string[]): Promise<{ architecture?: string; bitness?: string }>;
  }

  async function deviceArchitecture() {
    const userAgentData = (navigator as Navigator & { userAgentData?: UserAgentData })
      .userAgentData;

    if (userAgentData) {
      try {
        const { architecture, bitness } = await userAgentData.getHighEntropyValues([
          "architecture",
          "bitness",
        ]);
        const normalized = normalizeArchitecture(architecture ?? "", bitness);
        if (normalized) {
          return normalized;
        }
      } catch {}
    }

    const platform = normalizeArchitecture(navigator.platform);
    if (platform) {
      return platform;
    }

    const userAgentArchitecture = navigator.userAgent.match(
      /(?:x86[_-]?64|amd64|i[3-6]86|aarch64|arm64|armv7l?|armhf|riscv64|ppc64le|s390x)/i
    )?.[0];
    return normalizeArchitecture(userAgentArchitecture ?? "");
  }

  async function initializeInstallButtons() {
    for (const install of document.querySelectorAll<HTMLElement>("[data-install]")) {
      if (install.dataset.initialized) {
        continue;
      }
      install.dataset.initialized = "true";

      const button = install.querySelector<HTMLButtonElement>("[data-install-button]");
      const message = install.querySelector<HTMLElement>("[data-install-message]");
      if (!button || !message) {
        continue;
      }

      const artifacts = JSON.parse(install.dataset.artifacts ?? "[]") as Artifact[];
      const architecture = await deviceArchitecture();
      const artifact = artifacts.find((candidate) => candidate.architecture === architecture);

      const positionMessage = () => {
        const gap = 8;
        const margin = 16;
        const buttonBounds = button.getBoundingClientRect();
        const messageBounds = message.getBoundingClientRect();
        const left = Math.min(
          Math.max(buttonBounds.left, margin),
          window.innerWidth - messageBounds.width - margin
        );
        const below = buttonBounds.bottom + gap;
        const top =
          below + messageBounds.height <= window.innerHeight - margin
            ? below
            : Math.max(margin, buttonBounds.top - messageBounds.height - gap);

        message.style.left = `${left}px`;
        message.style.top = `${top}px`;
      };

      const handleToggle = (event: ToggleEvent) => {
        const open = event.newState === "open";
        button.setAttribute("aria-expanded", String(open));
        window[open ? "addEventListener" : "removeEventListener"]("resize", positionMessage);
        window[open ? "addEventListener" : "removeEventListener"]("scroll", positionMessage, true);
      };

      message.addEventListener("toggle", handleToggle);

      if (artifact) {
        button.setAttribute("aria-disabled", "false");
      } else if (!architecture) {
        message.textContent = "Your device architecture could not be detected.";
      } else if (artifacts.length === 1) {
        message.textContent = `This AppImage is built for ${artifacts[0]!.architecture}, but your device reports ${architecture}.`;
      } else {
        message.textContent = `This app does not provide an AppImage for your ${architecture} device.`;
      }

      button.addEventListener("click", () => {
        if (!artifact) {
          if (message.matches(":popover-open")) {
            message.hidePopover();
          } else {
            message.showPopover();
            positionMessage();
          }
          return;
        }

        const url = new URL("appmgr://install");
        url.searchParams.set("url", artifact.url);
        url.searchParams.set("sha256", artifact.sha256);
        window.location.href = url.href;
      });
    }
  }

  document.addEventListener("astro:page-load", initializeInstallButtons);
</script>
