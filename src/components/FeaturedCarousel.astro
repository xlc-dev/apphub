---
import type { CatalogAppResource } from "@/lib/catalog-loader";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
import { getLocale, translate } from "@/lib/i18n";
import { sitePath } from "@/lib/paths";

interface Props {
  apps: CatalogAppResource[];
}

const { apps } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
---

{
  apps.length > 0 && (
    <section
      class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-sm"
      aria-label={t("featured.label")}
      aria-roledescription={t("carousel.role")}
      data-featured-carousel>
      <div
        class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain scroll-smooth motion-reduce:scroll-auto"
        aria-live="off"
        data-featured-track>
        {apps.map((app, index) => (
          <article
            class="grid w-full shrink-0 snap-center md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]"
            aria-label={t("carousel.position", { index: index + 1, count: apps.length })}
            aria-roledescription={t("carousel.slide")}
            data-featured-slide>
            <div class="flex min-w-0 flex-col items-center justify-center px-14 pt-8 pb-16 text-center sm:px-16 md:items-start md:py-12 md:pr-8 md:pl-14 md:text-left">
              <Image
                class="size-14 shrink-0 rounded-xl"
                src={app.icon.url}
                alt=""
                width={56}
                height={56}
                priority={index === 0}
              />
              <h2 class="mt-5 text-2xl font-bold sm:text-3xl">
                <Link accent href={`/apps/${app.slug}/`}>
                  {app.name}
                </Link>
              </h2>
              <p class="mt-2 line-clamp-3 max-w-xl leading-6 text-[var(--muted)]">{app.summary}</p>
              <ButtonLink class="mt-5" href={`/apps/${app.slug}/`}>
                {t("app.view")}
              </ButtonLink>
            </div>
            <Link
              unstyled
              class="relative hidden aspect-[16/10] overflow-hidden bg-[var(--control-bg)] focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[var(--primary)] md:block"
              href={`/apps/${app.slug}/`}
              aria-label={t("featured.view", { name: app.name })}>
              <img
                class="absolute inset-0 size-full object-cover"
                src={sitePath(`/featured/${app.slug}.webp`)}
                alt=""
                width="1280"
                height="800"
                loading={index === 0 ? undefined : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
                decoding="async"
              />
            </Link>
          </article>
        ))}
      </div>
      {apps.length > 1 && (
        <div class="flex min-h-14 items-center justify-center border-t border-[var(--border)]">
          <Button
            icon
            hidden
            class="border-0 bg-transparent shadow-none"
            aria-label={t("featured.previous")}
            data-featured-previous>
            <Icon name="chevron-left" class="size-4" />
          </Button>
          <div class="flex" role="radiogroup" aria-label={t("featured.choose")}>
            {apps.map((_, index) => (
              <label
                class="flex size-11 cursor-pointer items-center justify-center rounded-full"
                data-featured-dot>
                <input
                  class="sr-only"
                  type="radio"
                  name="featured-slide"
                  checked={index === 0}
                  aria-label={t("featured.show", { index: index + 1, count: apps.length })}
                  data-featured-choice
                />
                <span class="size-2.5 rounded-full bg-[var(--border)]" aria-hidden="true" />
              </label>
            ))}
          </div>
          <Button
            icon
            hidden
            class="border-0 bg-transparent shadow-none"
            aria-label={t("featured.next")}
            data-featured-next>
            <Icon name="chevron-right" class="size-4" />
          </Button>
        </div>
      )}
    </section>
  )
}

<script>
  import { connectCarousel } from "@/lib/carousel";

  function initializeFeaturedCarousels() {
    for (const carousel of document.querySelectorAll<HTMLElement>("[data-featured-carousel]")) {
      if (carousel.dataset.initialized) {
        continue;
      }

      const track = carousel.querySelector<HTMLElement>("[data-featured-track]");
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-featured-slide]"));
      const choices = Array.from(
        carousel.querySelectorAll<HTMLInputElement>("[data-featured-choice]")
      );
      const previous = carousel.querySelector<HTMLButtonElement>("[data-featured-previous]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-featured-next]");

      if (!track || slides.length < 2 || !previous || !next) {
        continue;
      }

      carousel.dataset.initialized = "true";
      previous.hidden = false;
      next.hidden = false;

      connectCarousel({ track, slides, choices, previous, next });

      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let timeout = 0;
        const schedule = () => {
          clearTimeout(timeout);
          timeout = window.setTimeout(() => {
            next.click();
            schedule();
          }, 8000);
        };

        carousel.addEventListener("pointerdown", schedule);
        carousel.addEventListener("keydown", schedule);
        carousel.addEventListener("wheel", schedule);
        carousel.addEventListener("focusin", schedule);
        schedule();
      }
    }
  }

  initializeFeaturedCarousels();
</script>

<style>
  [data-featured-track] {
    scrollbar-width: none;
  }

  [data-featured-track]::-webkit-scrollbar {
    display: none;
  }

  [data-featured-dot]:has([data-featured-choice]:checked) span {
    background: var(--primary);
  }

  [data-featured-dot]:hover span {
    background: var(--primary);
  }

  [data-featured-dot]:has([data-featured-choice]:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: -0.25rem;
  }

  [data-featured-carousel]:not([data-initialized]) [data-featured-slide] {
    display: none;
  }

  [data-featured-carousel]:not([data-initialized]):has(
      [data-featured-dot]:nth-child(1) [data-featured-choice]:checked
    )
    [data-featured-slide]:nth-child(1),
  [data-featured-carousel]:not([data-initialized]):has(
      [data-featured-dot]:nth-child(2) [data-featured-choice]:checked
    )
    [data-featured-slide]:nth-child(2),
  [data-featured-carousel]:not([data-initialized]):has(
      [data-featured-dot]:nth-child(3) [data-featured-choice]:checked
    )
    [data-featured-slide]:nth-child(3),
  [data-featured-carousel]:not([data-initialized]):has(
      [data-featured-dot]:nth-child(4) [data-featured-choice]:checked
    )
    [data-featured-slide]:nth-child(4),
  [data-featured-carousel]:not([data-initialized]):has(
      [data-featured-dot]:nth-child(5) [data-featured-choice]:checked
    )
    [data-featured-slide]:nth-child(5) {
    display: grid;
  }
</style>
