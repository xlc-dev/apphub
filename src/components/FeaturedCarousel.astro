---
import type { CatalogAppResource } from "@/lib/catalog-loader";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  apps: CatalogAppResource[];
}

const { apps } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
---

{
  apps.length > 0 && (
    <section
      class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-sm"
      aria-label={t("featured.label")}
      aria-roledescription={t("carousel.role")}
      data-featured-carousel>
      <div
        class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain scroll-smooth motion-reduce:scroll-auto"
        aria-live="off"
        data-featured-track>
        {apps.map((app, index) => (
          <article
            class="grid min-h-80 w-full shrink-0 snap-center md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]"
            id={`featured-app-${index + 1}`}
            aria-label={t("carousel.position", { index: index + 1, count: apps.length })}
            aria-roledescription={t("carousel.slide")}
            data-featured-slide>
            <div class="flex min-w-0 flex-col items-center justify-center px-14 pt-8 pb-16 text-center sm:px-16 md:items-start md:py-12 md:pr-8 md:pl-14 md:text-left">
              <Image
                class="size-14 shrink-0 rounded-xl"
                src={app.icon.url}
                alt=""
                width={56}
                height={56}
                loading="eager"
              />
              <h2 class="mt-5 text-2xl font-bold sm:text-3xl">
                <Link accent href={`/apps/${app.slug}/`}>
                  {app.name}
                </Link>
              </h2>
              <p class="mt-2 line-clamp-3 max-w-xl leading-6 text-[var(--muted)]">{app.summary}</p>
              <ButtonLink class="mt-5" href={`/apps/${app.slug}/`}>
                {t("app.view")}
              </ButtonLink>
            </div>
            <Link
              unstyled
              class="relative hidden min-h-80 overflow-hidden bg-[var(--control-bg)] focus-visible:ring-[3px] focus-visible:ring-[color-mix(in_srgb,var(--primary)_20%,transparent)] focus-visible:outline-none focus-visible:ring-inset md:block"
              href={`/apps/${app.slug}/`}
              aria-label={t("featured.view", { name: app.name })}>
              <Image
                class="absolute inset-0 size-full scale-x-[1.12] object-cover"
                src={app.screenshots[0]!.url}
                alt={app.screenshots[0]!.caption}
                width={960}
                height={720}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </Link>
          </article>
        ))}
      </div>
      {apps.length > 1 && (
        <div class="flex min-h-14 items-center justify-center border-t border-[var(--border)]">
          <Button
            icon
            hidden
            class="border-0 bg-transparent shadow-none"
            aria-label={t("featured.previous")}
            data-featured-previous>
            <Icon name="chevron-left" class="size-4" />
          </Button>
          <nav class="flex" aria-label={t("featured.choose")}>
            {apps.map((_, index) => (
              <Link
                unstyled
                class="group flex size-11 cursor-pointer items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-[-0.25rem] focus-visible:outline-[var(--primary)]"
                href={`#featured-app-${index + 1}`}
                aria-label={t("featured.show", { index: index + 1, count: apps.length })}
                aria-current={index === 0 ? "true" : undefined}
                data-featured-dot>
                <span
                  class="size-2.5 rounded-full bg-[var(--border)] group-hover:bg-[var(--primary)]"
                  aria-hidden="true"
                />
              </Link>
            ))}
          </nav>
          <Button
            icon
            hidden
            class="border-0 bg-transparent shadow-none"
            aria-label={t("featured.next")}
            data-featured-next>
            <Icon name="chevron-right" class="size-4" />
          </Button>
        </div>
      )}
    </section>
  )
}

<script>
  import { connectCarousel } from "@/lib/carousel";

  function initializeFeaturedCarousels() {
    for (const carousel of document.querySelectorAll<HTMLElement>("[data-featured-carousel]")) {
      if (carousel.dataset.initialized) {
        continue;
      }

      const track = carousel.querySelector<HTMLElement>("[data-featured-track]");
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-featured-slide]"));
      const dots = Array.from(carousel.querySelectorAll<HTMLAnchorElement>("[data-featured-dot]"));
      const previous = carousel.querySelector<HTMLButtonElement>("[data-featured-previous]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-featured-next]");

      if (!track || slides.length < 2 || !previous || !next) {
        continue;
      }

      carousel.dataset.initialized = "true";
      previous.hidden = false;
      next.hidden = false;

      connectCarousel({ track, slides, dots, previous, next });

      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const events = new AbortController();
        let timeout = 0;
        const schedule = () => {
          clearTimeout(timeout);
          timeout = window.setTimeout(() => {
            next.click();
            schedule();
          }, 8000);
        };

        carousel.addEventListener("pointerdown", schedule, { signal: events.signal });
        carousel.addEventListener("keydown", schedule, { signal: events.signal });
        carousel.addEventListener("wheel", schedule, { signal: events.signal });
        carousel.addEventListener("focusin", schedule, { signal: events.signal });
        schedule();
      }
    }
  }

  initializeFeaturedCarousels();
</script>

<style>
  [data-featured-track] {
    scrollbar-width: none;
  }

  [data-featured-track]::-webkit-scrollbar {
    display: none;
  }

  [data-featured-dot][aria-current="true"] span {
    background: var(--primary);
  }
</style>
