---
import Link from "@/components/ui/Link.astro";
import { sitePath } from "@/lib/paths";
import { Image } from "astro:assets";

const logo = sitePath("/logo.svg");
---

<footer class="relative z-10 mt-12 border-t border-[var(--border)] bg-[var(--card)]">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 px-4 py-6 sm:flex-row sm:px-6">
    <Link
      unstyled
      class="flex items-center gap-2 rounded-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2"
      href="/">
      <Image src={logo} alt="" width={32} height={32} loading="eager" />
      AppHub
    </Link>
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2" aria-label="Footer navigation">
      <Link href="/privacy/">Privacy Policy</Link>
      <Link href="https://github.com/xlc-dev/apphub">AppHub repository</Link>
      <Link href="https://github.com/kem-a/AppManager">AppManager</Link>
    </nav>
  </div>
</footer>
