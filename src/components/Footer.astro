---
import Link from "@/components/ui/Link.astro";
import { getLocale, translate } from "@/lib/i18n";
import { sitePath } from "@/lib/paths";
import { Image } from "astro:assets";

const logo = sitePath("/logo.svg");
const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<footer class="relative z-10 mt-12 border-t border-[var(--border)] bg-[var(--card)]">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 px-4 py-6 sm:flex-row sm:px-6">
    <Link unstyled class="focus-ring flex items-center gap-2 rounded-sm font-bold" href="/">
      <Image src={logo} alt="" width={32} height={32} data-optimize-loading />
      AppHub
    </Link>
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2" aria-label={t("footer.navigation")}>
      <Link href="https://github.com/xlc-dev/apphub">{t("footer.repository")}</Link>
      <Link href="https://github.com/kem-a/AppManager">AppManager</Link>
      <Link href="/privacy/">{t("footer.privacy")}</Link>
    </nav>
  </div>
</footer>
