---
import Link from "@/components/ui/Link.astro";
import { Image } from "astro:assets";
---

<footer class="relative z-10 mt-12 border-t border-zinc-200 dark:border-zinc-800">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 px-4 py-6 sm:flex-row sm:px-6">
    <a
      class="flex items-center gap-2 rounded-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2"
      href="/">
      <Image src="/favicon.svg" alt="" width={32} height={32} loading="eager" />
      AppHub
    </a>
    <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2" aria-label="Footer navigation">
      <Link href="/privacy/">Privacy Policy</Link>
      <span class="text-zinc-500 dark:text-zinc-400">AppHub repository</span>
      <Link href="https://github.com/kem-a/AppManager">AppManager</Link>
    </nav>
  </div>
</footer>
