---
import Link from "@/components/ui/Link.astro";
import { buttonClasses } from "@/components/ui/button";

interface Props {
  basePath: string;
  class?: string;
  label: string;
  page: number;
  pages: number;
}

const { basePath, class: className, label, page, pages } = Astro.props;
const pagePath = (number: number) => (number === 1 ? basePath : `${basePath}page/${number}/`);
const controlClass = buttonClasses("outline", "default");
---

{
  pages > 1 && (
    <nav
      class:list={["flex items-center justify-center gap-4", className]}
      aria-label={label}
      data-static-pagination>
      {page > 1 ? (
        <Link unstyled class={controlClass} href={pagePath(page - 1)}>
          Previous
        </Link>
      ) : (
        <span class:list={[controlClass, "opacity-50"]}>Previous</span>
      )}
      <span class="min-w-24 text-center text-sm text-[var(--muted)]">
        Page {page} of {pages}
      </span>
      {page < pages ? (
        <Link unstyled class={controlClass} href={pagePath(page + 1)}>
          Next
        </Link>
      ) : (
        <span class:list={[controlClass, "opacity-50"]}>Next</span>
      )}
    </nav>
  )
}
