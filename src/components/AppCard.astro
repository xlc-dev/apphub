---
import type { ApiApp } from "@/lib/api";
import SourceBadge from "@/components/SourceBadge.astro";
import Link from "@/components/ui/Link.astro";
import { catalogSearchValue } from "@/lib/search";
import { categoryName } from "@/lib/categories";
import { Image } from "astro:assets";

interface Props {
  app: ApiApp;
  detail?: string;
  headingLevel?: 2 | 3;
  categoryMatch?: boolean;
  pageItem?: boolean;
  priority?: boolean;
  stars?: number | undefined;
}

const {
  app,
  categoryMatch = true,
  detail,
  headingLevel = 2,
  pageItem = false,
  priority = false,
  stars,
} = Astro.props;
const searchValue = catalogSearchValue(app);
const visibleCategories = app.categories.slice(0, 2).map(categoryName);
const hiddenCategoryCount = app.categories.length - visibleCategories.length;
const categories = [
  ...visibleCategories,
  ...(hiddenCategoryCount > 0 ? [`+${hiddenCategoryCount}`] : []),
].join(" · ");
---

<article
  class="min-w-0"
  data-catalog-app
  data-page-item={pageItem ? "" : undefined}
  data-app-categories={app.categories.join(" ")}
  data-category-match={String(categoryMatch)}
  hidden={!categoryMatch}
  data-search-value={searchValue}>
  <Link
    unstyled
    class="flex h-full min-h-36 cursor-pointer gap-4 rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 shadow-sm transition-[border-color,background-color] hover:border-[var(--primary)] hover:bg-[var(--card-raised)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] motion-reduce:transition-none"
    href={`/apps/${app.slug}/`}>
    <Image
      class="size-14 shrink-0 rounded-xl sm:size-16"
      src={app.icon.url}
      alt=""
      width={64}
      height={64}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
    <div class="min-w-0 grow">
      <div class="flex min-w-0 items-center gap-2">
        {
          headingLevel === 3 ? (
            <h3 class="truncate font-semibold">{app.name}</h3>
          ) : (
            <h2 class="truncate font-semibold">{app.name}</h2>
          )
        }
        <SourceBadge source={app.source} />
      </div>
      <p class="mt-1 line-clamp-2 text-sm leading-5 text-[var(--muted)]">{app.summary}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--muted)]">
        {detail && <span>{detail}</span>}
        {
          stars !== undefined && (
            <span
              class="inline-flex items-center gap-1"
              aria-label={`${stars.toLocaleString("en")} repository stars`}>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-3.5" fill="currentColor">
                <path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5-4.7-4.6 6.5-.9L12 2.5Z" />
              </svg>
              {stars.toLocaleString("en")}
            </span>
          )
        }
        <span class="truncate">{categories}</span>
      </div>
    </div>
  </Link>
</article>
