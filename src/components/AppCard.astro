---
import type { ApiApp } from "@/lib/api";
import CategoryLinks from "@/components/CategoryLinks.astro";
import SourceBadge from "@/components/SourceBadge.astro";
import { catalogSearchValue } from "@/lib/search";
import Link from "@/components/ui/Link.astro";
import { Image } from "astro:assets";

interface Props {
  app: ApiApp;
  priority?: boolean;
}

const { app, priority = false } = Astro.props;
const searchValue = catalogSearchValue(app);
---

<article
  class="flex items-start gap-4 sm:items-center"
  data-catalog-app
  data-search-value={searchValue}>
  <Image
    class="size-14 shrink-0 rounded-xl sm:size-16"
    src={app.icon.url}
    alt=""
    width={64}
    height={64}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
  />
  <div class="min-w-0 break-words">
    <div class="flex items-center gap-2">
      <h2 class="text-lg font-semibold">
        <Link href={`/apps/${app.slug}`}>{app.name}</Link>
      </h2>
      <SourceBadge source={app.source} />
    </div>
    <p class="leading-7 text-zinc-700 dark:text-zinc-300">{app.summary}</p>
    <CategoryLinks categories={app.categories} />
  </div>
</article>
