---
import type { ApiApp } from "@/lib/api";
import SourceBadge from "@/components/SourceBadge.astro";
import Icon from "@/components/Icon.astro";
import CardLink from "@/components/ui/CardLink.astro";
import { catalogSearchValue } from "@/lib/search";
import { categoryName } from "@/lib/categories";
import { Image } from "astro:assets";

type CardApp = Pick<ApiApp, "slug" | "name" | "summary" | "source" | "categories" | "icon"> &
  Partial<Pick<ApiApp, "description" | "developer" | "keywords" | "mimeTypes">>;

interface Props {
  app: CardApp;
  detail?: string;
  headingLevel?: 2 | 3;
  priority?: boolean;
  searchable?: boolean;
  stars?: number | undefined;
  visible?: boolean;
}

const {
  app,
  detail,
  headingLevel = 2,
  priority = false,
  searchable = false,
  stars,
  visible = true,
} = Astro.props;
const searchValue =
  searchable && app.description && app.developer ? catalogSearchValue(app as ApiApp) : undefined;
const visibleCategories = app.categories.slice(0, 2).map(categoryName);
const hiddenCategoryCount = app.categories.length - visibleCategories.length;
const categories = visibleCategories.join(", ");
---

<article
  class="h-32 min-w-0"
  data-catalog-app={searchable ? "" : undefined}
  data-initial-visible={searchable ? String(visible) : undefined}
  hidden={!visible}
  data-search-value={searchValue}>
  <CardLink
    class="flex h-full cursor-pointer gap-4 overflow-hidden p-4"
    href={`/apps/${app.slug}/`}>
    <Image
      class="size-14 shrink-0 rounded-xl sm:size-16"
      src={app.icon.url}
      alt=""
      width={64}
      height={64}
      loading="eager"
      fetchpriority={priority ? "high" : "auto"}
    />
    <div class="min-w-0 grow overflow-hidden">
      <div class="flex min-w-0 items-center gap-2">
        {
          headingLevel === 3 ? (
            <h3 class="truncate font-semibold">{app.name}</h3>
          ) : (
            <h2 class="truncate font-semibold">{app.name}</h2>
          )
        }
        <SourceBadge source={app.source} />
      </div>
      <p class="mt-1 line-clamp-2 min-h-10 text-sm leading-5 text-[var(--muted)]">
        {app.summary}
      </p>
      <div
        class="mt-3 flex min-w-0 items-center gap-3 overflow-hidden text-xs whitespace-nowrap text-[var(--muted)]">
        {detail && <span class="shrink-0">{detail}</span>}
        {
          stars !== undefined && (
            <span
              class="inline-flex shrink-0 items-center gap-1"
              aria-label={`${stars.toLocaleString("en")} repository stars`}>
              <Icon name="star" class="size-3.5" />
              {stars.toLocaleString("en")}
            </span>
          )
        }
        <span class="flex min-w-0 items-center">
          <span class="truncate">{categories}</span>
          {hiddenCategoryCount > 0 && <span class="shrink-0">, +{hiddenCategoryCount}</span>}
        </span>
      </div>
    </div>
  </CardLink>
</article>
