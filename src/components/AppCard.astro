---
import { categoryPath } from "@/lib/categories";

interface Props {
  app: {
    slug: string;
    name: string;
    summary: string;
    icon: string;
    categories: string[];
  };
}

const { app } = Astro.props;
---

<article class="flex items-center gap-4">
  <img class="rounded-xl" src={app.icon} alt="" width="64" height="64" loading="lazy" />
  <div>
    <h2 class="text-lg font-semibold">
      <a class="hover:text-zinc-600 dark:hover:text-zinc-300" href={`/apps/${app.slug}`}>
        {app.name}
      </a>
    </h2>
    <p>{app.summary}</p>
    {
      app.categories.length > 0 && (
        <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400">
          {app.categories.map((category) => (
            <a class="hover:text-zinc-950 dark:hover:text-zinc-50" href={categoryPath(category)}>
              {category}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>
