---
import type { CatalogApp } from "@/lib/catalog";
import CategoryLinks from "@/components/CategoryLinks.astro";
import { catalogSearchValue } from "@/lib/search";
import Link from "@/components/ui/Link.astro";

interface Props {
  app: CatalogApp;
}

const { app } = Astro.props;
const searchValue = catalogSearchValue(app);
---

<article
  class="flex items-start gap-4 sm:items-center"
  data-catalog-app
  data-search-value={searchValue}>
  <img
    class="size-14 shrink-0 rounded-xl sm:size-16"
    src={app.icon}
    alt=""
    width="64"
    height="64"
    loading="lazy"
  />
  <div class="min-w-0">
    <h2 class="text-lg font-semibold">
      <Link href={`/apps/${app.slug}`}>{app.name}</Link>
    </h2>
    <p class="leading-7 text-zinc-700 dark:text-zinc-300">{app.summary}</p>
    <CategoryLinks categories={app.categories} />
  </div>
</article>
