---
interface Props {
  source: "official" | "community";
}

const { source } = Astro.props;
const official = source === "official";
---

<span
  class:list={[
    "inline-flex rounded-full border text-xs",
    official
      ? "border-accent bg-accent px-2.5 py-1 font-bold text-black"
      : "dark:border-control border-zinc-200 px-2 py-0.5 font-medium text-zinc-500 dark:text-zinc-400",
  ]}>
  {official ? "Official" : "Community"}
</span>
