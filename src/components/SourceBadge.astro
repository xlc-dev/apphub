---
import Icon from "@/components/icons/Icon.astro";

interface Props {
  source: "official" | "community";
}

const { source } = Astro.props;
const official = source === "official";
---

<span
  class:list={[
    "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs",
    official
      ? "border-[var(--primary)] bg-[var(--primary)] font-bold text-[var(--primary-text)]"
      : "border-[var(--border)] bg-[var(--control-bg)] font-medium text-[var(--text)]",
  ]}>
  <Icon name={official ? "official" : "community"} class="size-3.5" />
  {official ? "Official" : "Community"}
</span>
