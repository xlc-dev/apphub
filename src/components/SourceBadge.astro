---
interface Props {
  source: "official" | "community";
}

const { source } = Astro.props;
const official = source === "official";
---

<span
  class:list={[
    "inline-flex shrink-0 rounded-full border text-xs",
    official
      ? "border-[var(--primary)] bg-[var(--primary)] px-2 py-0.5 font-bold text-[var(--primary-text)]"
      : "border-[var(--border)] px-2 py-0.5 font-medium text-[var(--muted)]",
  ]}>
  {official ? "Official" : "Community"}
</span>
