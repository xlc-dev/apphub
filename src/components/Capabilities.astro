---
import type { App } from "#catalog/schema";
import Section from "@/components/ui/Section.astro";
import { getLocale, translate, translateValue } from "@/lib/i18n";

interface Props {
  sandbox: App["sandbox"];
}

const { sandbox } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
const labels = (values: string[]) =>
  values.map((value) => translateValue(locale, value)).join(", ");
const filesystem = sandbox.filesystem.length
  ? sandbox.filesystem
      .map(
        ({ location, access }) =>
          `${translateValue(locale, location)} (${translateValue(locale, access)})`
      )
      .join(", ")
  : t("sandbox.privateStorage");
const devices = sandbox.devices.length ? labels(sandbox.devices) : t("sandbox.none");
const portals = sandbox.portals.length ? labels(sandbox.portals) : t("sandbox.none");
const sessionBus = sandbox.sessionBus.length
  ? t("sandbox.services", { count: sandbox.sessionBus.length })
  : t("sandbox.none");
const systemBus = sandbox.systemBus.length
  ? t("sandbox.services", { count: sandbox.systemBus.length })
  : t("sandbox.none");
const capabilities = [
  [t("sandbox.network"), translateValue(locale, sandbox.network)],
  [t("sandbox.display"), translateValue(locale, sandbox.display)],
  [t("sandbox.audio"), translateValue(locale, sandbox.audio)],
  [t("sandbox.processes"), translateValue(locale, sandbox.processes)],
  [t("sandbox.ipc"), sandbox.ipc ? t("sandbox.allowed") : t("sandbox.denied")],
  [t("sandbox.files"), filesystem],
  [t("sandbox.devices"), devices],
  [t("sandbox.portals"), portals],
  [t("sandbox.sessionBus"), sessionBus],
  [t("sandbox.systemBus"), systemBus],
] as const;
---

<Section
  spaced={false}
  title={t("sandbox.title")}
  headingId="capabilities-heading"
  aria-labelledby="capabilities-heading">
  <dl class="grid grid-cols-2 gap-3">
    {
      capabilities.map(([name, value]) => (
        <div class="card-surface min-w-0 rounded-xl p-3 sm:p-4">
          <dt class="font-semibold">{name}</dt>
          <dd class="m-0 mt-1 text-sm text-[var(--muted)] capitalize">{value}</dd>
        </div>
      ))
    }
  </dl>
</Section>
