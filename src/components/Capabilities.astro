---
import type { App } from "@catalog/schema";
import EmptyState from "@/components/ui/EmptyState.astro";
import Section from "@/components/ui/Section.astro";

interface Props {
  security: App["security"];
}

const { security } = Astro.props;
const capabilities = {
  network: ["Internet access", "Connects to services on the internet."],
  "home-files": ["Home files", "Reads or writes files in your home directory."],
  "removable-media": ["Removable media", "Accesses connected removable storage."],
  devices: ["Devices", "Communicates with connected hardware."],
  "session-bus": ["Desktop services", "Communicates with services in your session."],
  "system-bus": ["System services", "Communicates with system services."],
} as const;
---

<Section
  spaced={false}
  title="Capabilities"
  headingId="capabilities-heading"
  aria-labelledby="capabilities-heading">
  <p class="text-sm leading-6 text-zinc-500 dark:text-zinc-400">
    AppImages run unsandboxed. These are expected behaviors, not enforced restrictions.
  </p>
  {
    security.expectedAccess.length > 0 ? (
      <ul class="mt-4 grid list-none gap-3 p-0 sm:grid-cols-2">
        {security.expectedAccess.map((access) => (
          <li class="flex gap-3 rounded-xl border border-zinc-200 p-4 dark:border-zinc-800">
            <span class="mt-2 size-2 shrink-0 rounded-full bg-amber-500" aria-hidden="true" />
            <span>
              <strong class="block">{capabilities[access][0]}</strong>
              <span class="mt-1 block text-sm leading-5 text-zinc-600 dark:text-zinc-400">
                {capabilities[access][1]}
              </span>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState>No additional capabilities are expected.</EmptyState>
    )
  }
</Section>
