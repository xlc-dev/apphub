---
import type { App } from "@catalog/schema";
import Section from "@/components/ui/Section.astro";

interface Props {
  sandbox: App["sandbox"];
}

const { sandbox } = Astro.props;
const labels = (values: string[]) => values.map((value) => value.replaceAll("-", " ")).join(", ");
const capabilities = [
  ["Network", sandbox.network],
  ["Display", sandbox.display],
  ["Audio", sandbox.audio],
  ["Processes", sandbox.processes],
  ["Host IPC", sandbox.ipc ? "allowed" : "denied"],
  [
    "Files",
    sandbox.filesystem.length
      ? sandbox.filesystem
          .map(({ location, access }) => `${location.replaceAll("-", " ")} (${access})`)
          .join(", ")
      : "private app storage only",
  ],
  ["Devices", sandbox.devices.length ? labels(sandbox.devices) : "none"],
  ["Portals", sandbox.portals.length ? labels(sandbox.portals) : "none"],
  [
    "Session bus",
    sandbox.sessionBus.length ? `${sandbox.sessionBus.length} named service(s)` : "none",
  ],
  [
    "System bus",
    sandbox.systemBus.length ? `${sandbox.systemBus.length} named service(s)` : "none",
  ],
] as const;
---

<Section
  spaced={false}
  title="Sandbox access"
  headingId="capabilities-heading"
  aria-labelledby="capabilities-heading">
  <dl class="grid grid-cols-2 gap-3">
    {
      capabilities.map(([name, value]) => (
        <div class="min-w-0 rounded-xl border border-[var(--border)] bg-[var(--card)] p-3 sm:p-4">
          <dt class="font-semibold">{name}</dt>
          <dd class="m-0 mt-1 text-sm text-[var(--muted)] capitalize">{value}</dd>
        </div>
      ))
    }
  </dl>
</Section>
