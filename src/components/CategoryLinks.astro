---
import { categoryPath } from "@/lib/categories";
import Link from "@/components/ui/Link.astro";

interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

{
  categories.length > 0 && (
    <p class="flex flex-wrap gap-2">
      {categories.map((category) => (
        <Link chip href={categoryPath(category)}>
          {category}
        </Link>
      ))}
    </p>
  )
}
