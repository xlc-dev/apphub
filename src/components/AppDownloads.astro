---
import type { CatalogApp } from "@/lib/catalog";
import { formatBytes } from "@/lib/format";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";

interface Props {
  releases: CatalogApp["releases"];
}

const { releases } = Astro.props;
const latest = releases[0];
const releaseDate = latest
  ? new Date(latest.publishedAt).toLocaleDateString("en", { dateStyle: "long", timeZone: "UTC" })
  : undefined;
---

<section
  class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800"
  aria-labelledby="downloads-heading">
  <h2 class="text-xl font-bold" id="downloads-heading">Downloads</h2>
  {
    latest ? (
      <>
        <p class="text-zinc-500 dark:text-zinc-400">
          <Link href={latest.page}>Version {latest.version}</Link>
          {releaseDate && (
            <>
              {" · "}
              <time datetime={latest.publishedAt}>{releaseDate}</time>
            </>
          )}
        </p>
        <div class="mt-4 divide-y divide-zinc-200 dark:divide-zinc-800">
          {latest.artifacts.map((artifact) => (
            <div class="py-4 first:pt-0 last:pb-0">
              <div class="grid gap-3">
                <div>
                  <p class="m-0 font-semibold">{artifact.architecture}</p>
                  <p class="m-0 mt-1 text-sm text-zinc-500 dark:text-zinc-400">
                    {formatBytes(artifact.size)}
                  </p>
                </div>
                <ButtonLink class="text-center" href={artifact.url}>
                  Download
                </ButtonLink>
              </div>
              <details class="group mt-3 text-sm">
                <summary class="focus-visible:outline-accent flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-sm text-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-zinc-400">
                  SHA-256 checksum
                  <svg
                    class="size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none"
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <code class="mt-2 block break-all">{artifact.sha256}</code>
              </details>
            </div>
          ))}
        </div>
      </>
    ) : (
      <EmptyState>No downloads are available.</EmptyState>
    )
  }
</section>
