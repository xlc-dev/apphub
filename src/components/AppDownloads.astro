---
import type { ApiApp } from "@/lib/api";
import { formatBytes, formatVersion } from "@/lib/format";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  releases: ApiApp["releases"];
}

const { releases } = Astro.props;
const latest = releases[0];
const releaseDate = latest
  ? new Date(latest.publishedAt).toLocaleDateString("en", { dateStyle: "long", timeZone: "UTC" })
  : undefined;
---

<section
  class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 shadow-sm"
  aria-labelledby="downloads-heading">
  <h2 class="text-xl font-bold" id="downloads-heading">Direct downloads</h2>
  {
    latest ? (
      <>
        <p class="text-[var(--muted)]">
          <Link href={latest.page}>Version {formatVersion(latest.version)}</Link>
          {releaseDate && (
            <>
              {", "}
              <time datetime={latest.publishedAt}>{releaseDate}</time>
            </>
          )}
        </p>
        <div class="mt-4 divide-y divide-[var(--border)]">
          {latest.artifacts.map((artifact) => (
            <div class="py-4 first:pt-0 last:pb-0">
              <div class="grid gap-3">
                <div>
                  <p class="m-0 font-semibold">{artifact.architecture}</p>
                  <p class="m-0 mt-1 text-sm text-[var(--muted)]">{formatBytes(artifact.size)}</p>
                </div>
                <ButtonLink
                  class="text-center"
                  href={artifact.url}
                  aria-label={`Download version ${formatVersion(latest.version)} for ${artifact.architecture}`}>
                  Download
                </ButtonLink>
              </div>
              <details class="group mt-3 text-sm">
                <summary
                  class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-sm text-[var(--muted)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
                  aria-label={`SHA-256 checksum for ${artifact.architecture}`}>
                  SHA-256 checksum
                  <Icon
                    name="chevron-down"
                    class="size-4 transition-transform group-open:rotate-180 motion-reduce:transition-none"
                  />
                </summary>
                <code class="mt-2 block break-all">{artifact.sha256}</code>
              </details>
            </div>
          ))}
        </div>
      </>
    ) : (
      <EmptyState>No downloads are available.</EmptyState>
    )
  }
</section>
