---
import Link from "@/components/ui/Link.astro";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;
const { class: className, ...attributes } = Astro.props;
---

<Link
  {...attributes}
  unstyled
  class:list={[
    "rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-sm transition-[background-color,box-shadow] hover:bg-[var(--card-raised)] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] motion-reduce:transition-none",
    className,
  ]}>
  <slot />
</Link>
