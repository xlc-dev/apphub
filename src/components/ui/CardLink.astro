---
import Link from "@/components/ui/Link.astro";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;
const { class: className, ...attributes } = Astro.props;
---

<Link
  {...attributes}
  unstyled
  class:list={[
    "focus-ring card-surface rounded-xl shadow-sm transition-[background-color,box-shadow] hover:bg-[var(--card-raised)] hover:shadow-md motion-reduce:transition-none",
    className,
  ]}>
  <slot />
</Link>
