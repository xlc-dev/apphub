---
import Link from "@/components/ui/Link.astro";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;
const { class: className, ...attributes } = Astro.props;
---

<Link
  {...attributes}
  unstyled
  class:list={[
    "rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-sm transition-[background-color,box-shadow] hover:bg-[var(--card-raised)] hover:shadow-md focus-visible:ring-[3px] focus-visible:ring-[color-mix(in_srgb,var(--primary)_20%,transparent)] focus-visible:outline-none motion-reduce:transition-none",
    className,
  ]}>
  <slot />
</Link>
