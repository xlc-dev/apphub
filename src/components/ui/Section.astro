---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  title: string;
  headingId?: string;
  spaced?: boolean;
}

const { title, headingId, spaced = true, class: className, ...attributes } = Astro.props;
---

<section {...attributes} class:list={[spaced && "mt-10", className]}>
  <h2 class="mb-3 text-2xl font-bold" id={headingId}>{title}</h2>
  <slot />
</section>
