---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  title: string;
  headingId?: string;
  spaced?: boolean;
}

const { title, headingId, spaced = true, class: className, ...attributes } = Astro.props;
---

<section {...attributes} class:list={[spaced && "mt-10", className]}>
  <div class="mb-3 flex items-center justify-between gap-4">
    <h2 class="text-2xl font-bold" id={headingId}>{title}</h2>
    <slot name="actions" />
  </div>
  <slot />
</section>
