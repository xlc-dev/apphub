---
interface Props {
  groupLabel: string;
  labels: string[];
  name: string;
}

const { groupLabel, labels, name } = Astro.props;
---

<div class="flex" role="radiogroup" aria-label={groupLabel}>
  {
    labels.map((label, index) => (
      <span
        class="relative flex size-11 cursor-pointer items-center justify-center rounded-full"
        data-carousel-dot>
        <input
          class="peer absolute size-11 cursor-pointer appearance-none rounded-full"
          type="radio"
          name={name}
          checked={index === 0}
          aria-label={label}
          data-carousel-choice
        />
        <span class="sr-only">{label}</span>
        <span
          class="pointer-events-none size-2.5 rounded-full bg-[var(--border)]"
          aria-hidden="true"
        />
      </span>
    ))
  }
</div>
