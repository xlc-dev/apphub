---
import type { HTMLAttributes } from "astro/types";
import { buttonClasses, type ButtonSize, type ButtonVariant } from "@/components/ui/buttonStyles";

interface Props extends HTMLAttributes<"button"> {
  icon?: boolean;
  large?: boolean;
  variant?: ButtonVariant;
}

const {
  icon = false,
  large = false,
  variant,
  class: className,
  type = "button",
  ...attributes
} = Astro.props;

const buttonVariant = variant ?? (icon ? "icon" : "outline");
let buttonSize: ButtonSize = "default";

if (icon) {
  buttonSize = "icon";
} else if (large) {
  buttonSize = "large";
}
---

<button
  {...attributes}
  type={type}
  class:list={[buttonClasses(buttonVariant, buttonSize), className]}>
  <slot />
</button>
