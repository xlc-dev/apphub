---
import type { HTMLAttributes } from "astro/types";
import { getLocale, localePath, type Locale } from "@/lib/i18n";
import { sitePath } from "@/lib/paths";

interface Props extends HTMLAttributes<"a"> {
  accent?: boolean;
  chip?: boolean;
  locale?: Locale;
  unstyled?: boolean;
}

const {
  accent = false,
  chip = false,
  locale = getLocale(Astro.currentLocale),
  unstyled = false,
  href,
  class: className,
  ...attributes
} = Astro.props;

const localizedHref = typeof href === "string" ? sitePath(localePath(href, locale)) : href;

let linkClass: string | undefined;

if (!unstyled) {
  if (chip) {
    linkClass =
      "focus-ring rounded-full bg-[var(--control-bg)] px-2.5 py-1 text-xs font-medium text-[var(--muted)] hover:bg-[var(--card-raised)] aria-[current=page]:bg-[var(--primary)] aria-[current=page]:text-[var(--primary-text)]";
  } else if (accent) {
    linkClass = "focus-ring rounded-sm text-[var(--primary)] hover:underline";
  } else {
    linkClass =
      "focus-ring rounded-sm hover:text-[var(--primary)] aria-[current=page]:text-[var(--primary)]";
  }
}
---

<a {...attributes} href={localizedHref} class:list={[linkClass, className]}><slot /></a>
