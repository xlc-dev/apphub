---
import type { HTMLAttributes } from "astro/types";
import { getLocale, localePath, type Locale } from "@/lib/i18n";
import { sitePath } from "@/lib/paths";

interface Props extends HTMLAttributes<"a"> {
  accent?: boolean;
  chip?: boolean;
  locale?: Locale;
  unstyled?: boolean;
}

const {
  accent = false,
  chip = false,
  locale = getLocale(Astro.currentLocale),
  unstyled = false,
  href,
  class: className,
  ...attributes
} = Astro.props;
---

<a
  {...attributes}
  href={typeof href === "string" ? sitePath(localePath(href, locale)) : href}
  class:list={[
    unstyled
      ? undefined
      : chip
        ? "rounded-full bg-[var(--control-bg)] px-2.5 py-1 text-xs font-medium text-[var(--muted)] hover:bg-[var(--card-raised)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] aria-[current=page]:bg-[var(--primary)] aria-[current=page]:text-[var(--primary-text)]"
        : accent
          ? "rounded-sm text-[var(--primary)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
          : "rounded-sm border-b-2 border-transparent hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] aria-[current=page]:border-[var(--primary)] aria-[current=page]:text-[var(--primary)]",
    className,
  ]}><slot /></a
>
