---
import type { HTMLAttributes } from "astro/types";
import { sitePath } from "@/lib/paths";

type Props = HTMLAttributes<"a">;
const { href, class: className, ...attributes } = Astro.props;
---

<a
  {...attributes}
  href={typeof href === "string" ? sitePath(href) : href}
  class:list={[
    "bg-surface text-foreground dark:bg-foreground dark:text-surface focus-visible:outline-accent inline-block min-h-11 rounded-lg px-4 py-2.5 font-semibold hover:bg-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 dark:hover:bg-zinc-200",
    className,
  ]}><slot /></a
>
