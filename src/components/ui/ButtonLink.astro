---
import type { HTMLAttributes } from "astro/types";
import { getLocale, localePath } from "@/lib/i18n";
import { sitePath } from "@/lib/paths";
import { buttonClasses, type ButtonSize, type ButtonVariant } from "@/components/ui/buttonStyles";

interface Props extends HTMLAttributes<"a"> {
  size?: ButtonSize;
  variant?: ButtonVariant;
}

const { href, size = "large", variant = "primary", class: className, ...attributes } = Astro.props;
---

<a
  {...attributes}
  href={typeof href === "string"
    ? sitePath(localePath(href, getLocale(Astro.currentLocale)))
    : href}
  class:list={[buttonClasses(variant, size), className]}><slot /></a
>
