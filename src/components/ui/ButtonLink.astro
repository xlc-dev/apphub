---
import type { HTMLAttributes } from "astro/types";
import { sitePath } from "@/lib/paths";

type Props = HTMLAttributes<"a">;
const { href, class: className, ...attributes } = Astro.props;
---

<a
  {...attributes}
  href={typeof href === "string" ? sitePath(href) : href}
  class:list={[
    "inline-block min-h-11 rounded-lg bg-[var(--primary)] px-4 py-2.5 font-semibold text-[var(--primary-text)] hover:bg-[var(--primary-hover)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]",
    className,
  ]}><slot /></a
>
