---
interface Props {
  title: string;
  description?: string;
  meta?: string;
}

const { title, description, meta } = Astro.props;
---

<header class="mb-8">
  <h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
  {
    description && (
      <p class="mt-2 max-w-2xl text-lg leading-7 text-zinc-600 dark:text-zinc-300">
        {description}
      </p>
    )
  }
  {meta && <p class="mt-6 text-sm text-zinc-500 dark:text-zinc-400">{meta}</p>}
</header>
