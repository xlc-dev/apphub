---
import AppCard from "@/components/AppCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import { routePath } from "@/lib/paths";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getRanking, type RankingPeriod } from "@/lib/api";

interface Props {
  title: string;
  description: string;
  period: RankingPeriod;
}

const { title, description, period } = Astro.props;
const { entries: ranking } = await getRanking(period);
const path = routePath(Astro.url.pathname);
---

<BaseLayout title={title} description={description}>
  <Page>
    <PageHeader title={title} description={description} />
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Download rankings">
      <Link href="/trending/" aria-current={path === "/trending/" ? "page" : undefined}
        >This week</Link
      >
      <Link href="/trending/month/" aria-current={path === "/trending/month/" ? "page" : undefined}
        >This month</Link
      >
      <Link
        href="/trending/all-time/"
        aria-current={path === "/trending/all-time/" ? "page" : undefined}>All time</Link
      >
    </nav>
    {
      ranking === null ? (
        <div class="mt-8">
          <EmptyState>Download history is not available yet.</EmptyState>
        </div>
      ) : ranking.length === 0 ? (
        <div class="mt-8">
          <EmptyState>No download data is available.</EmptyState>
        </div>
      ) : (
        <ol class="mt-8 grid gap-6 pl-6 sm:pl-8">
          {ranking.map(({ app, downloads }, index) => (
            <li>
              <AppCard app={app} priority={index < 4} />
              <p class="text-sm text-zinc-500 dark:text-zinc-400">
                {downloads.toLocaleString("en")} downloads
              </p>
            </li>
          ))}
        </ol>
      )
    }
  </Page>
</BaseLayout>
