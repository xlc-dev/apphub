---
import type { CatalogAppSummary } from "@/lib/catalog-model";
import AppCollection from "@/components/AppCollection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getRanking, localizeAppSummaries, type RankingPeriod } from "@/lib/catalog-queries";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  page?: number;
  period: RankingPeriod;
}

const { page = 1, period } = Astro.props;
const collection = await getRanking(period);
const locale = getLocale(Astro.currentLocale);
const localizedApps = collection.entries
  ? await localizeAppSummaries(
      collection.entries.map(({ app }) => app),
      locale
    )
  : [];
const ranking =
  collection.entries?.map((entry, index) => ({ ...entry, app: localizedApps[index]! })) ?? null;
const paths: Record<RankingPeriod, string> = {
  week: "/trending/",
  month: "/trending/month/",
  "all-time": "/trending/all-time/",
};
const translationKey = period === "all-time" ? "allTime" : period;
const basePath = paths[period];
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
const title = t(`ranking.${translationKey}Title`);
const description = t(`ranking.${translationKey}Description`);
const downloadCounts = new Map(
  ranking?.map(({ app, downloads }) => [app.slug, downloads] as const) ?? []
);
const getDetail = (app: CatalogAppSummary) => {
  const downloads = downloadCounts.get(app.slug);

  return downloads === undefined
    ? undefined
    : t("downloads.count", { count: downloads.toLocaleString(locale) });
};
---

<BaseLayout title={title} description={description} index={page === 1}>
  <Page>
    <PageHeader title={title} description={description} />
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label={t("ranking.navigation")}>
      <Link href="/trending/" aria-current={period === "week" ? "page" : undefined}
        >{t("ranking.week")}</Link
      >
      <Link href="/trending/month/" aria-current={period === "month" ? "page" : undefined}
        >{t("ranking.month")}</Link
      >
      <Link href="/trending/all-time/" aria-current={period === "all-time" ? "page" : undefined}
        >{t("ranking.allTime")}</Link
      >
    </nav>
    {
      ranking === null ? (
        <EmptyState class="mt-8">{t("ranking.historyUnavailable")}</EmptyState>
      ) : (
        <AppCollection
          class="mt-8"
          apps={ranking.map(({ app }) => app)}
          basePath={basePath}
          empty={t("ranking.none")}
          getDetail={getDetail}
          heading={t("apps.applications")}
          page={page}
          paginationLabel={t("ranking.pages")}
        />
      )
    }
  </Page>
</BaseLayout>
