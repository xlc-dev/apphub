---
import AppCard from "@/components/AppCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import { routePath } from "@/lib/paths";
import PageHeader from "@/components/ui/PageHeader.astro";
import PaginatedList from "@/components/PaginatedList.astro";
import { getRanking, type RankingPeriod } from "@/lib/api";
import { getRepositoryStars } from "@/lib/repository-stars";

interface Props {
  title: string;
  description: string;
  period: RankingPeriod;
}

const { title, description, period } = Astro.props;
const { entries: ranking } = await getRanking(period);
const path = routePath(Astro.url.pathname);
const stars = await getRepositoryStars();
---

<BaseLayout title={title} description={description}>
  <Page>
    <PageHeader title={title} description={description} />
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Download rankings">
      <Link href="/trending/" aria-current={path === "/trending/" ? "page" : undefined}
        >This week</Link
      >
      <Link href="/trending/month/" aria-current={path === "/trending/month/" ? "page" : undefined}
        >This month</Link
      >
      <Link
        href="/trending/all-time/"
        aria-current={path === "/trending/all-time/" ? "page" : undefined}>All time</Link
      >
    </nav>
    {
      ranking === null ? (
        <EmptyState class="mt-8">Download history is not available yet.</EmptyState>
      ) : ranking.length === 0 ? (
        <EmptyState class="mt-8">No download data is available.</EmptyState>
      ) : (
        <PaginatedList class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3" label="ranking">
          {ranking.map(({ app, downloads }, index) => (
            <AppCard
              app={app}
              detail={`${index + 1}. ${downloads.toLocaleString("en")} downloads`}
              pageItem
              priority={index < 6}
              stars={stars[app.slug]}
            />
          ))}
        </PaginatedList>
      )
    }
  </Page>
</BaseLayout>
