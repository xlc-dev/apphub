---
import type { CatalogAppSummary } from "@/lib/catalog-model";
import AppCollection from "@/components/AppCollection.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getUpdatedApps, localizeAppSummaries } from "@/lib/catalog-queries";
import { formatVersion } from "@/lib/format";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const apps = await localizeAppSummaries((await getUpdatedApps()).apps, locale);
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
const releaseDate = new Intl.DateTimeFormat(locale, { dateStyle: "medium" });
const getDetail = (app: CatalogAppSummary) =>
  `${formatVersion(app.latestRelease!.version)}, ${releaseDate.format(new Date(app.latestRelease!.publishedAt))}`;
---

<BaseLayout title={t("updated.title")} description={t("updated.description")} index={page === 1}>
  <Page>
    <PageHeader title={t("updated.title")} description={t("updated.description")} />
    <AppCollection
      apps={apps}
      basePath="/updated/"
      empty={t("releases.none")}
      getDetail={getDetail}
      heading={t("apps.applications")}
      page={page}
      paginationLabel={t("updated.pages")}
    />
  </Page>
</BaseLayout>
