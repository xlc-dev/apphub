---
import ScreenshotCarousel from "@/components/ScreenshotCarousel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  app: {
    slug: string;
    name: string;
    summary: string;
    description: string;
    icon: string;
    screenshots: Array<{ url: string; caption?: string | undefined }>;
  };
}

const { app } = Astro.props;
---

<BaseLayout title={app.name} description={app.summary} image={app.screenshots[0]!.url} transitions>
  <div class="flex items-center gap-6">
    <img class="rounded-2xl" src={app.icon} alt="" width="96" height="96" />
    <div>
      <h1 class="text-3xl font-bold">{app.name}</h1>
      <p>{app.summary}</p>
    </div>
  </div>
  <p>{app.description}</p>
  <ScreenshotCarousel label="Screenshots" screenshots={app.screenshots} />
</BaseLayout>
