---
import type { CatalogApp } from "@/lib/catalog";
import Capabilities from "@/components/Capabilities.astro";
import AppDetails from "@/components/AppDetails.astro";
import AppDownloads from "@/components/AppDownloads.astro";
import CategoryLinks from "@/components/CategoryLinks.astro";
import ScreenshotCarousel from "@/components/ScreenshotCarousel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Page from "@/components/ui/Page.astro";
import Section from "@/components/ui/Section.astro";

interface Props {
  app: CatalogApp;
}

const { app } = Astro.props;
---

<BaseLayout title={app.name} description={app.summary} image={app.screenshots[0]!.url}>
  <Page>
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
      <img class="size-20 rounded-2xl sm:size-24" src={app.icon} alt="" width="96" height="96" />
      <div class="min-w-0">
        <h1 class="text-3xl font-bold sm:text-4xl">{app.name}</h1>
        <p class="mt-1 max-w-2xl text-lg leading-7 text-zinc-600 dark:text-zinc-300">
          {app.summary}
        </p>
        <CategoryLinks categories={app.categories} />
      </div>
    </div>
    <AppDownloads releases={app.releases} />
    <ScreenshotCarousel label="Screenshots" screenshots={app.screenshots} />
    <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        <Section
          spaced={false}
          title="About"
          headingId="about-heading"
          aria-labelledby="about-heading">
          <p class="text-lg leading-7 text-zinc-700 dark:text-zinc-300">{app.description}</p>
        </Section>
        <Capabilities security={app.security} />
      </div>
      <AppDetails app={app} />
    </div>
  </Page>
</BaseLayout>
