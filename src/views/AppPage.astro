---
import type { ApiApp } from "@/lib/api";
import Capabilities from "@/components/Capabilities.astro";
import AppDetails from "@/components/AppDetails.astro";
import AppDownloads from "@/components/AppDownloads.astro";
import CategoryLinks from "@/components/CategoryLinks.astro";
import ScreenshotCarousel from "@/components/ScreenshotCarousel.astro";
import SourceBadge from "@/components/SourceBadge.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Page from "@/components/ui/Page.astro";
import Section from "@/components/ui/Section.astro";
import { Image } from "astro:assets";

interface Props {
  app: ApiApp;
}

const { app } = Astro.props;
---

<BaseLayout
  title={app.name}
  description={app.summary}
  image={app.screenshots[0]!.url}
  imageAlt={app.screenshots[0]!.caption ?? `${app.name} screenshot`}
  imageType={app.screenshots[0]!.type}
  pageType="product">
  <Page>
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
      <Image
        class="size-20 rounded-2xl sm:size-24"
        src={app.icon.url}
        alt=""
        width={96}
        height={96}
        loading="eager"
        fetchpriority="high"
      />
      <div class="min-w-0 break-words">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold sm:text-4xl">{app.name}</h1>
          <SourceBadge source={app.source} />
        </div>
        <p class="mt-1 max-w-2xl text-lg leading-7 text-zinc-600 dark:text-zinc-300">
          {app.summary}
        </p>
        <CategoryLinks categories={app.categories} />
      </div>
    </div>
    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
      <div class="contents lg:block">
        <div class="order-1">
          <Section
            spaced={false}
            title="About"
            headingId="about-heading"
            aria-labelledby="about-heading">
            <p class="text-lg leading-7 text-zinc-700 dark:text-zinc-300">{app.description}</p>
          </Section>
        </div>
        <div class="order-3 min-w-0 lg:mt-10">
          <ScreenshotCarousel label="Screenshots" screenshots={app.screenshots} />
        </div>
        <div class="order-4 lg:mt-10">
          <Capabilities expectedAccess={app.expectedAccess} />
        </div>
      </div>
      <div class="contents lg:block">
        <div class="order-2 self-start">
          <AppDownloads releases={app.releases} />
        </div>
        <div class="order-5 self-start lg:mt-8">
          <AppDetails app={app} />
        </div>
      </div>
    </div>
  </Page>
</BaseLayout>
