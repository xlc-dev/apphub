---
import AppCard from "@/components/AppCard.astro";
import CategorySidebar from "@/components/CategorySidebar.astro";
import Pagination from "@/components/Pagination.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getApps, getCategories } from "@/lib/api";
import { paginationState } from "@/lib/pagination";
import { getRepositoryStars } from "@/lib/repository-stars";

interface Props {
  category?: string;
  categoryName?: string;
  page?: number;
}

const { category, categoryName, page = 1 } = Astro.props;
const catalog = await getApps();
const categories = await getCategories();
const stars = await getRepositoryStars();
const heading = category ? `${categoryName} Apps` : "All apps";
const displayedCatalog = category
  ? catalog.filter((app) => app.categories.includes(category))
  : catalog;
const state = paginationState(displayedCatalog.length, page);
---

<BaseLayout title={category ? heading : "Apps"} description={`${heading}.`}>
  <Page>
    <PageHeader title={heading} id="catalog-heading" />
    <div class="grid gap-8 lg:grid-cols-[13rem_minmax(0,1fr)]">
      <CategorySidebar categories={categories} current={category} currentName={categoryName} />
      <div class="min-w-0">
        {
          displayedCatalog.length > 0 ? (
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {displayedCatalog.map((app, index) => (
                <AppCard
                  app={app}
                  priority={index >= state.start && index < Math.min(state.start + 6, state.end)}
                  searchable
                  stars={stars[app.slug]}
                  visible={Boolean(category) || (index >= state.start && index < state.end)}
                />
              ))}
            </div>
          ) : (
            <EmptyState>No apps are available.</EmptyState>
          )
        }
        <div class="mt-8" hidden data-search-empty>
          <EmptyState>No apps match these filters.</EmptyState>
        </div>
      </div>
      {
        !category && (
          <Pagination
            class="lg:col-span-2 lg:col-start-1"
            basePath="/apps/"
            label="App pages"
            page={state.page}
            pages={state.pages}
          />
        )
      }
    </div>
  </Page>
</BaseLayout>

<script>
  import { matchesSearch } from "@/lib/search";

  function initializeCatalogFilters() {
    const form = document.querySelector<HTMLFormElement>("[data-catalog-search]");

    if (!form || form.dataset.initialized) {
      return;
    }

    const input = form.querySelector<HTMLInputElement>("[data-catalog-search-input]");
    const status = form.querySelector<HTMLElement>("[data-search-status]");
    const apps = Array.from(document.querySelectorAll<HTMLElement>("[data-catalog-app]"));
    const empty = document.querySelector<HTMLElement>("[data-search-empty]");

    if (!input || !status || !empty) {
      return;
    }

    form.dataset.initialized = "true";
    form.hidden = false;

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let matches = 0;

      for (const app of apps) {
        const match = matchesSearch(app.dataset.searchValue!, query);
        app.hidden = query ? !match : app.dataset.initialVisible !== "true";
        if (query ? match : app.dataset.initialVisible === "true") {
          matches++;
        }
      }

      empty.hidden = matches !== 0;
      const pagination = document.querySelector<HTMLElement>("[data-static-pagination]");
      if (pagination) {
        pagination.hidden = query !== "";
      }
      status.textContent = query ? `${matches} ${matches === 1 ? "app" : "apps"} found` : "";
    };

    input.addEventListener("input", () => filter());
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      filter();
    });

    input.value = new URL(location.href).searchParams.get("q") ?? "";
    filter();
  }

  document.addEventListener("astro:page-load", initializeCatalogFilters);
</script>
