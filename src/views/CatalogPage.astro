---
import AppCard from "@/components/AppCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCatalog } from "@/lib/catalog";
import { categoryPath } from "@/lib/categories";

interface Props {
  category?: string;
}

const { category } = Astro.props;
const catalog = await getCatalog();
const apps = category ? catalog.filter((app) => app.categories.includes(category)) : catalog;
const categories = [...new Set(catalog.flatMap((app) => app.categories))].sort((a, b) =>
  a.localeCompare(b)
);
const heading = category ? `${category} Apps` : "AppImages for Linux";
---

<BaseLayout title={category ? heading : "AppHub"} description={`${heading}.`}>
  <h1 class="text-3xl font-bold">{heading}</h1>
  <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2" aria-label="Categories">
    <a class="hover:text-zinc-600 dark:hover:text-zinc-300" href="/">All</a>
    {
      categories.map((name) => (
        <a
          class="hover:text-zinc-600 dark:hover:text-zinc-300"
          href={categoryPath(name)}
          aria-current={name === category ? "page" : undefined}>
          {name}
        </a>
      ))
    }
  </nav>
  <form class="mt-6" role="search" hidden data-catalog-search>
    <label class="sr-only" for="catalog-search">Search apps</label>
    <input
      class="w-full max-w-md rounded-lg border border-zinc-300 bg-transparent px-3 py-2 outline-none focus:border-zinc-950 dark:border-zinc-700 dark:focus:border-zinc-50"
      id="catalog-search"
      type="search"
      name="q"
      placeholder={category ? `Search ${category} apps` : "Search apps"}
      autocomplete="off"
      data-catalog-search-input
    />
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400" aria-live="polite" data-search-status>
    </p>
  </form>
  <div class="mt-8 grid gap-6">
    {apps.map((app) => <AppCard app={app} />)}
  </div>
  <p class="mt-8" hidden data-search-empty>No apps match your search.</p>
</BaseLayout>

<script>
  import { matchesSearch } from "@/lib/search";

  function initializeCatalogSearch() {
    const form = document.querySelector<HTMLFormElement>("[data-catalog-search]");

    if (!form || form.dataset.initialized) return;

    const input = form.querySelector<HTMLInputElement>("[data-catalog-search-input]");
    const status = form.querySelector<HTMLElement>("[data-search-status]");
    const apps = Array.from(document.querySelectorAll<HTMLElement>("[data-catalog-app]"));
    const empty = document.querySelector<HTMLElement>("[data-search-empty]");

    if (!input || !status || !empty) return;

    form.dataset.initialized = "true";
    form.hidden = false;

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let matches = 0;

      for (const app of apps) {
        app.hidden = !matchesSearch(app.dataset.searchValue!, query);
        if (!app.hidden) matches++;
      }

      empty.hidden = query === "" || matches !== 0;
      status.textContent =
        query === "" ? "" : `${matches} ${matches === 1 ? "app" : "apps"} found`;
    };

    const parameters = new URLSearchParams(location.search);
    input.value = parameters.get("q") ?? "";

    input.addEventListener("input", filter);
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const url = new URL(location.href);
      const query = input.value.trim();

      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");

      history.replaceState({}, "", url);
      filter();
    });

    filter();
  }

  document.addEventListener("astro:page-load", initializeCatalogSearch);
</script>
