---
import AppCard from "@/components/AppCard.astro";
import Pagination from "@/components/Pagination.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNewApps, localizeAppSummaries } from "@/lib/catalog-queries";
import { paginationState } from "@/lib/pagination";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const collection = await getNewApps();
const locale = getLocale(Astro.currentLocale);
const apps = await localizeAppSummaries(collection.apps, locale);
const { windowDays } = collection;
const state = paginationState(apps.length, page);
const displayedApps = apps.slice(state.start, state.end);
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
---

<BaseLayout
  title={t("new.title")}
  description={t("new.description", { days: windowDays })}
  index={page === 1}>
  <Page>
    <PageHeader
      title={t("new.title")}
      description={t("new.shortDescription", { days: windowDays })}
    />
    {
      apps.length > 0 ? (
        <section aria-labelledby="new-apps-heading">
          <h2 class="sr-only" id="new-apps-heading">
            {t("apps.applications")}
          </h2>
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {displayedApps.map((app, index) => (
              <AppCard app={app} priority={index < 6} stars={app.statistics.stars ?? undefined} />
            ))}
          </div>
          <Pagination
            class="mt-8"
            basePath="/new/"
            label={t("new.pages")}
            page={state.page}
            pages={state.pages}
          />
        </section>
      ) : (
        <EmptyState>{t("new.none")}</EmptyState>
      )
    }
  </Page>
</BaseLayout>
