---
import AppCollection from "@/components/AppCollection.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNewApps, localizeAppSummaries } from "@/lib/catalog-queries";
import { getLocale, translate } from "@/lib/i18n";

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const collection = await getNewApps();
const locale = getLocale(Astro.currentLocale);
const apps = await localizeAppSummaries(collection.apps, locale);
const { windowDays } = collection;
const t = (key: Parameters<typeof translate>[1], values?: Record<string, unknown>) =>
  translate(locale, key, values);
---

<BaseLayout
  title={t("new.title")}
  description={t("new.description", { days: windowDays })}
  index={page === 1}>
  <Page>
    <PageHeader
      title={t("new.title")}
      description={t("new.shortDescription", { days: windowDays })}
    />
    <AppCollection
      apps={apps}
      basePath="/new/"
      empty={t("new.none")}
      heading={t("apps.applications")}
      page={page}
      paginationLabel={t("new.pages")}
    />
  </Page>
</BaseLayout>
