---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
---

<BaseLayout title="Privacy" description="How AppHub handles visitor and download data.">
  <Page narrow>
    <PageHeader
      title="Privacy"
      description="AppHub does not track individual visitors. We only use aggregate download counts."
      meta="Last updated August 19, 2026"
    />

    <div class="space-y-10">
      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title="What AppHub collects">
        <p class="leading-7 text-[var(--muted)]">
          AppHub records aggregate AppImage download totals published by release providers. These
          totals generate the trending lists. They are not used to identify you or build a profile
          about you.
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title="What AppHub does not collect">
        <p class="leading-7 text-[var(--muted)]">
          AppHub does not have user accounts, advertising, tracking cookies, fingerprinting, or
          client-side analytics. We do not sell or share personal data.
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title="Hosting and downloads">
        <p class="leading-7 text-[var(--muted)]">
          AppHub is hosted by GitHub Pages. App downloads are provided by their publishers,
          including through GitHub. Those services process requests under their own privacy
          policies. GitHub's processing is governed by the{" "}
          <Link
            accent
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            >GitHub General Privacy Statement</Link
          >.
        </p>
      </Section>

      <Section spaced={false} class="border-t border-[var(--border)] pt-8" title="Data retention">
        <p class="leading-7 text-[var(--muted)]">
          AppHub keeps aggregate download snapshots for trending calculations. We do not store
          individual visit or download records. Hosting and release providers control the retention
          of data they process.
        </p>
      </Section>

      <Section spaced={false} class="border-t border-[var(--border)] pt-8" title="External links">
        <p class="leading-7 text-[var(--muted)]">
          App pages may link to third-party websites and source repositories. Their own privacy
          policies apply when you visit them.
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title="Changes to this policy">
        <p class="leading-7 text-[var(--muted)]">
          Any material changes will be published here with an updated date.
        </p>
      </Section>
    </div>
  </Page>
</BaseLayout>
