---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
---

<BaseLayout title="Privacy" description="How AppHub handles visitor and download data.">
  <Page narrow>
    <PageHeader
      title="Privacy"
      description="AppHub does not track individual visitors. We only use anonymous, aggregate page-visit and download counts."
      meta="Last updated August 19, 2026"
    />

    <div class="space-y-10">
      <Section
        spaced={false}
        class="dark:border-control border-t border-zinc-200 pt-8"
        title="What AppHub collects">
        <p class="leading-7 text-zinc-700 dark:text-zinc-300">
          AppHub only uses anonymous, aggregate page-visit and download counts. These totals help
          us understand which pages are useful and generate the trending lists. They are not used
          to identify you or build a profile about you.
        </p>
      </Section>

      <Section
        spaced={false}
        class="dark:border-control border-t border-zinc-200 pt-8"
        title="What AppHub does not collect">
        <p class="leading-7 text-zinc-700 dark:text-zinc-300">
          AppHub does not have user accounts, advertising, tracking cookies, fingerprinting, or
          client-side analytics. We do not sell or share personal data.
        </p>
      </Section>

      <Section
        spaced={false}
        class="dark:border-control border-t border-zinc-200 pt-8"
        title="Hosting and downloads">
        <p class="leading-7 text-zinc-700 dark:text-zinc-300">
          AppHub is hosted by GitHub Pages, and app downloads are provided through GitHub. GitHub
          processes requests to provide and secure those services, including logging visitor IP
          addresses for security. That processing is governed by the{" "}
          <Link
            accent
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            >GitHub General Privacy Statement</Link
          >.
        </p>
      </Section>

      <Section
        spaced={false}
        class="dark:border-control border-t border-zinc-200 pt-8"
        title="Data retention">
        <p class="leading-7 text-zinc-700 dark:text-zinc-300">
          AppHub keeps aggregate download snapshots for trending calculations. We do not store
          individual visit or download records. GitHub controls the retention of data it processes
          as the hosting and download provider.
        </p>
      </Section>

      <Section
        spaced={false}
        class="dark:border-control border-t border-zinc-200 pt-8"
        title="External links">
        <p class="leading-7 text-zinc-700 dark:text-zinc-300">
          App pages may link to third-party websites and source repositories. Their own privacy
          policies apply when you visit them.
        </p>
      </Section>

      <Section
        spaced={false}
        class="dark:border-control border-t border-zinc-200 pt-8"
        title="Changes to this policy">
        <p class="leading-7 text-zinc-700 dark:text-zinc-300">
          Any material changes will be published here with an updated date.
        </p>
      </Section>
    </div>
  </Page>
</BaseLayout>
