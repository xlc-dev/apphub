---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
import { getLocale, translate } from "@/lib/i18n";
import { localePaths } from "@/lib/static-pages";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<BaseLayout title={t("privacy.title")} description={t("privacy.description")}>
  <Page narrow>
    <PageHeader
      title={t("privacy.title")}
      description={t("privacy.summary")}
      meta={t("privacy.updated")}
    />

    <div class="space-y-10">
      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.collectsTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.collects")}
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.notCollectTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.notCollect")}
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.localTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.local")}
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.hostingTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.hostingBefore")}
          {" "}
          <Link
            accent
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            >{t("privacy.github")}</Link
          >.
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.retentionTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.retention")}
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.externalTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.external")}
        </p>
      </Section>

      <Section
        spaced={false}
        class="border-t border-[var(--border)] pt-8"
        title={t("privacy.changesTitle")}>
        <p class="leading-7 text-[var(--muted)]">
          {t("privacy.changes")}
        </p>
      </Section>
    </div>
  </Page>
</BaseLayout>
