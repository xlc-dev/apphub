---
import type { GetStaticPaths } from "astro";
import RankingPage from "@/views/RankingPage.astro";
import { rankingPagePaths } from "@/lib/static-pages";

export const getStaticPaths = (() => rankingPagePaths("month")) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<RankingPage
  title="Trending this month"
  description="Most downloaded AppImages this month."
  period="month"
  page={page}
/>
