---
import type { GetStaticPaths } from "astro";
import RankingPage from "@/views/RankingPage.astro";
import { rankingPagePaths } from "@/lib/static-pages";

export const getStaticPaths = (() => rankingPagePaths("all-time")) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<RankingPage
  title="Trending all time"
  description="Most downloaded AppImages of all time."
  period="all-time"
  page={page}
/>
