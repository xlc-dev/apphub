---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StoreAppCard from "@/components/StoreAppCard.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getCatalog } from "@/lib/catalog";
import { newApps, newAppWindowDays } from "@/lib/new-apps";

const apps = newApps(await getCatalog());
---

<BaseLayout
  title="New apps"
  description={`Apps added to AppHub in the last ${newAppWindowDays} days.`}>
  <Page>
    <PageHeader
      title="New apps"
      description={`Added to AppHub in the last ${newAppWindowDays} days.`}
    />
    {
      apps.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {apps.map((app, index) => (
            <StoreAppCard app={app} priority={index < 3} />
          ))}
        </div>
      ) : (
        <EmptyState>No new apps are available.</EmptyState>
      )
    }
  </Page>
</BaseLayout>
