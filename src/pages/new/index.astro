---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCard from "@/components/AppCard.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import PaginatedList from "@/components/PaginatedList.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getNewApps } from "@/lib/api";
import { getRepositoryStars } from "@/lib/repository-stars";

const { apps, windowDays } = await getNewApps();
const stars = await getRepositoryStars();
---

<BaseLayout title="New apps" description={`Apps added to AppHub in the last ${windowDays} days.`}>
  <Page>
    <PageHeader title="New apps" description={`Added to AppHub in the last ${windowDays} days.`} />
    {
      apps.length > 0 ? (
        <section aria-labelledby="new-apps-heading">
          <h2 class="sr-only" id="new-apps-heading">
            Applications
          </h2>
          <PaginatedList class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {apps.map((app, index) => (
              <AppCard app={app} pageItem priority={index < 6} stars={stars[app.slug]} />
            ))}
          </PaginatedList>
        </section>
      ) : (
        <EmptyState>No new apps are available.</EmptyState>
      )
    }
  </Page>
</BaseLayout>
