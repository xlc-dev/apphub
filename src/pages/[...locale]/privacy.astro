---
import type { GetStaticPaths } from "astro";
import PrivacySection from "@/components/PrivacySection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getLocale, translate } from "@/lib/i18n";
import { localePaths } from "@/lib/static-pages";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<BaseLayout title={t("privacy.title")} description={t("privacy.description")}>
  <Page narrow>
    <PageHeader
      title={t("privacy.title")}
      description={t("privacy.summary")}
      meta={t("privacy.updated")}
    />

    <div class="space-y-10">
      <PrivacySection title={t("privacy.collectsTitle")}>
        {t("privacy.collects")}
      </PrivacySection>
      <PrivacySection title={t("privacy.notCollectTitle")}>
        {t("privacy.notCollect")}
      </PrivacySection>
      <PrivacySection title={t("privacy.localTitle")}>{t("privacy.local")}</PrivacySection>
      <PrivacySection title={t("privacy.hostingTitle")}>
        {t("privacy.hostingBefore")}{" "}
        <Link
          accent
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">
          {t("privacy.github")}
        </Link>.
      </PrivacySection>
      <PrivacySection title={t("privacy.retentionTitle")}>
        {t("privacy.retention")}
      </PrivacySection>
      <PrivacySection title={t("privacy.externalTitle")}>
        {t("privacy.external")}
      </PrivacySection>
      <PrivacySection title={t("privacy.changesTitle")}>
        {t("privacy.changes")}
      </PrivacySection>
    </div>
  </Page>
</BaseLayout>
