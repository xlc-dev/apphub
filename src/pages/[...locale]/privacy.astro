---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
import { getLocale, translate } from "@/lib/i18n";
import { localePaths } from "@/lib/static-pages";

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const locale = getLocale(Astro.currentLocale);
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
const sections = [
  { title: "privacy.collectsTitle", body: "privacy.collects" },
  { title: "privacy.notCollectTitle", body: "privacy.notCollect" },
  { title: "privacy.localTitle", body: "privacy.local" },
  { title: "privacy.hostingTitle" },
  { title: "privacy.retentionTitle", body: "privacy.retention" },
  { title: "privacy.externalTitle", body: "privacy.external" },
  { title: "privacy.changesTitle", body: "privacy.changes" },
] as const;
---

<BaseLayout title={t("privacy.title")} description={t("privacy.description")}>
  <Page narrow>
    <PageHeader
      title={t("privacy.title")}
      description={t("privacy.summary")}
      meta={t("privacy.updated")}
    />

    <div class="space-y-10">
      {
        sections.map(({ title, ...section }) => (
          <Section spaced={false} class="border-t border-[var(--border)] pt-8" title={t(title)}>
            <p class="leading-7 text-[var(--muted)]">
              {"body" in section ? (
                t(section.body)
              ) : (
                <>
                  {t("privacy.hostingBefore")}{" "}
                  <Link
                    accent
                    href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">
                    {t("privacy.github")}
                  </Link>
                  .
                </>
              )}
            </p>
          </Section>
        ))
      }
    </div>
  </Page>
</BaseLayout>
