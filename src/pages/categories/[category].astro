---
import type { GetStaticPaths } from "astro";
import { getCategories } from "@/lib/api";
import CatalogPage from "@/views/CatalogPage.astro";

export const getStaticPaths = (async () => {
  const categories = await getCategories();

  return categories.map(({ id, name, slug }) => ({
    params: { category: slug },
    props: { category: id, categoryName: name },
  }));
}) satisfies GetStaticPaths;

const { category, categoryName } = Astro.props;
---

<CatalogPage category={category} categoryName={categoryName} />
