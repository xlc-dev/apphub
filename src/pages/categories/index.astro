---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getCatalog } from "@/lib/catalog";
import { categoryPath } from "@/lib/categories";

const apps = await getCatalog();
const counts = new Map<string, number>();

for (const app of apps) {
  for (const category of app.categories) counts.set(category, (counts.get(category) ?? 0) + 1);
}

const categories = [...counts].sort(([left], [right]) => left.localeCompare(right));
---

<BaseLayout title="Categories" description="Browse AppHub applications by category.">
  <Page>
    <PageHeader title="Categories" description="Browse applications by category." />
    <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 md:grid-cols-3">
      {
        categories.map(([category, count]) => (
          <li class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
            <Link href={categoryPath(category)}>
              {category} ({count})
            </Link>
          </li>
        ))
      }
    </ul>
  </Page>
</BaseLayout>
