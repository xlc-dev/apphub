---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getCategories } from "@/lib/api";

const categories = await getCategories();
---

<BaseLayout title="Categories" description="Browse AppHub applications by category.">
  <Page>
    <PageHeader title="Categories" description="Browse applications by category." />
    {
      categories.length > 0 ? (
        <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 md:grid-cols-3">
          {categories.map(({ name, slug, count }) => (
            <li class="dark:border-control rounded-xl border border-zinc-200">
              <Link class="block min-h-11 p-5" href={`/categories/${slug}`}>
                {name} ({count})
              </Link>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState>No categories are available.</EmptyState>
      )
    }
  </Page>
</BaseLayout>
