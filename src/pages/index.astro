---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCard from "@/components/AppCard.astro";
import FeaturedCarousel from "@/components/FeaturedCarousel.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import Page from "@/components/ui/Page.astro";
import Section from "@/components/ui/Section.astro";
import { getApps, getCategories, getRanking } from "@/lib/api";
import { formatVersion } from "@/lib/format";
import { featuredAppSlugs } from "@/lib/featured";
import { getRepositoryStars } from "@/lib/repository-stars";

const catalog = await getApps();
const recentlyUpdated = catalog
  .filter((app) => app.releases[0])
  .sort(
    (left, right) =>
      Date.parse(right.releases[0]!.publishedAt) - Date.parse(left.releases[0]!.publishedAt)
  )
  .slice(0, 3);
const ranking = await getRanking("week");
const trending = ranking.entries?.slice(0, 3) ?? null;
const categories = await getCategories();
const popularCategories = [...categories]
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name))
  .slice(0, 12);
const stars = await getRepositoryStars();
const featured = featuredAppSlugs
  .flatMap((slug) => {
    const app = catalog.find((entry) => entry.slug === slug);
    return app ? [app] : [];
  })
  .slice(0, 3);
const releaseDate = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
---

<BaseLayout title="AppHub" description="The Universal AppImage Store.">
  <Page>
    <h1 class="sr-only">AppHub</h1>
    <div>
      <FeaturedCarousel apps={featured} stars={stars} />
    </div>

    <Section title="Recently updated">
      <Link slot="actions" href="/apps/" aria-label="More recently updated apps">More</Link>
      {
        recentlyUpdated.length > 0 ? (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {recentlyUpdated.map((app, index) => (
              <AppCard
                app={app}
                detail={`${formatVersion(app.releases[0]!.version)} · ${releaseDate.format(new Date(app.releases[0]!.publishedAt))}`}
                headingLevel={3}
                priority={index < 3}
                stars={stars[app.slug]}
              />
            ))}
          </div>
        ) : (
          <EmptyState>No releases are available.</EmptyState>
        )
      }
    </Section>

    <Section title="Trending this week">
      <Link slot="actions" href="/trending/" aria-label="More trending apps">More</Link>
      {
        trending === null ? (
          <EmptyState>Download history is not available yet.</EmptyState>
        ) : trending.length === 0 ? (
          <EmptyState>No download data is available.</EmptyState>
        ) : (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {trending.map(({ app, downloads }) => (
              <AppCard
                app={app}
                detail={`${downloads.toLocaleString("en")} downloads`}
                headingLevel={3}
                stars={stars[app.slug]}
              />
            ))}
          </div>
        )
      }
    </Section>

    <Section title="Categories">
      <Link slot="actions" href="/apps/" aria-label="Browse all categories">More</Link>
      {
        popularCategories.length > 0 ? (
          <ul class="grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
            {popularCategories.map(({ name, slug, count }) => (
              <li>
                <Link
                  unstyled
                  class="flex min-h-16 items-center justify-between rounded-xl border border-[var(--border)] bg-[var(--card)] px-5 py-3 font-semibold shadow-sm hover:border-[var(--primary)] hover:bg-[var(--card-raised)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
                  href={`/categories/${slug}/`}>
                  <span>{name}</span>
                  <span class="text-sm font-normal text-[var(--muted)]">{count}</span>
                </Link>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState>No categories are available.</EmptyState>
        )
      }
    </Section>
  </Page>
</BaseLayout>
