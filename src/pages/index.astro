---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppCard from "@/components/AppCard.astro";
import DiscoverCarousel from "@/components/DiscoverCarousel.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import Link from "@/components/ui/Link.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Page from "@/components/ui/Page.astro";
import Section from "@/components/ui/Section.astro";
import { getApiApps, getArchitectures, getCategories, getRanking, getUpdatedApps } from "@/lib/api";
import { formatVersion } from "@/lib/format";
import { discoverApps } from "@/lib/discover";

const catalog = await getApiApps();
const recentlyUpdated = (await getUpdatedApps()).apps.slice(0, 3);
const ranking = await getRanking("week");
const trending = ranking.entries?.slice(0, 3) ?? null;
const categories = await getCategories();
const architectures = await getArchitectures();
const popularCategories = [...categories]
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name))
  .slice(0, 12);
const discovered = discoverApps(catalog);
const releaseDate = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
---

<BaseLayout title="AppHub" description="The Universal AppImage Store.">
  <Page>
    <header class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">The Universal AppImage Store</h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg leading-7 text-[var(--muted)]">
        Discover portable Linux applications, inspect their permissions, and download verified
        AppImages directly from their publishers.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <ButtonLink href="/apps/">Browse apps</ButtonLink>
        <ButtonLink href="/new/" variant="outline">See new apps</ButtonLink>
      </div>
    </header>

    <div class="mt-8">
      <DiscoverCarousel apps={discovered} />
    </div>

    <Section
      title="Recently updated"
      description="Apps with the newest upstream AppImage releases.">
      <Link slot="actions" href="/updated/" aria-label="More recently updated apps">More</Link>
      {
        recentlyUpdated.length > 0 ? (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {recentlyUpdated.map((app, index) => (
              <AppCard
                app={app}
                detail={`${formatVersion(app.latestRelease!.version)}, ${releaseDate.format(new Date(app.latestRelease!.publishedAt))}`}
                headingLevel={3}
                priority={index < 3}
                stars={app.statistics.stars ?? undefined}
              />
            ))}
          </div>
        ) : (
          <EmptyState>No releases are available.</EmptyState>
        )
      }
    </Section>

    <Section title="Trending this week" description="Most downloaded during the last seven days.">
      <Link slot="actions" href="/trending/" aria-label="More trending apps">More</Link>
      {
        trending === null ? (
          <EmptyState>Download history is not available yet.</EmptyState>
        ) : trending.length === 0 ? (
          <EmptyState>No download data is available.</EmptyState>
        ) : (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {trending.map(({ app, downloads }) => (
              <AppCard
                app={app}
                detail={`${downloads.toLocaleString("en")} downloads`}
                headingLevel={3}
                stars={app.statistics.stars ?? undefined}
              />
            ))}
          </div>
        )
      }
    </Section>

    <Section
      title="Browse by category"
      description={`${catalog.length} apps available across ${categories.length} categories and ${architectures.length} architectures.`}>
      <Link slot="actions" href="/apps/" aria-label="Browse all categories">More</Link>
      {
        popularCategories.length > 0 ? (
          <ul class="flex list-none flex-wrap gap-2 p-0">
            {popularCategories.map(({ name, slug, count }) => (
              <li>
                <Link
                  chip
                  class="inline-flex min-h-11 items-center gap-2 px-4 py-2 text-sm"
                  href={`/categories/${slug}/`}>
                  <span>{name}</span>
                  <span class="font-normal opacity-70">{count}</span>
                </Link>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState>No categories are available.</EmptyState>
        )
      }
    </Section>
  </Page>
</BaseLayout>
