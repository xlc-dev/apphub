---
import "@/global.css";
import "@fontsource-variable/inter";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { sitePath } from "@/lib/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageType?: "image/avif" | "image/jpeg" | "image/png" | "image/webp";
  pageType?: "website" | "product";
}

const { title, description, image, imageAlt, imageType, pageType = "website" } = Astro.props;
const pageTitle = title === "AppHub" ? title : `${title} - AppHub`;
const logo = sitePath("/logo.svg");
---

<!doctype html>
<html lang="en" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content="AppHub" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="AppHub" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={pageType} />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <link rel="icon" type="image/svg+xml" href={logo} />
    <link rel="icon" href={sitePath("/favicon.ico")} />
    <link
      rel="alternate"
      type="application/json"
      href={sitePath("/api/v1/apps.json")}
      title="AppHub catalog"
    />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    {image && imageType && <meta property="og:image:type" content={imageType} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {image && <meta name="twitter:image" content={image} />}
    {image && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <ClientRouter fallback="animate" />
  </head>
  <body
    class="text-surface dark:bg-canvas dark:text-foreground relative m-0 flex min-h-screen flex-col bg-white font-sans">
    <a
      class="bg-surface text-foreground dark:bg-foreground dark:text-surface fixed top-2 left-2 z-[100] -translate-y-20 rounded-lg px-4 py-2 focus:translate-y-0"
      href="#main-content">Skip to content</a
    >
    <Header />
    <main
      class="relative z-10 mx-auto w-full max-w-6xl grow px-4 outline-none sm:px-6"
      id="main-content"
      tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
