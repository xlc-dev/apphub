---
import "@/global.css";
import "@fontsource-variable/inter";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import {
  getLocale,
  localeDefinitions,
  localePath,
  locales,
  stripLocale,
  translate,
} from "@/lib/i18n";
import { sitePath } from "@/lib/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageType?: "image/avif" | "image/jpeg" | "image/png" | "image/webp";
  pageType?: "website" | "product";
  index?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageType,
  pageType = "website",
  index = true,
} = Astro.props;
const pageTitle = title === "AppHub" ? title : `${title} - AppHub`;
const logo = sitePath("/logo.svg");
const socialImage = new URL(image ?? sitePath("/apphub.png"), Astro.site);
const socialImageAlt = imageAlt ?? "AppHub";
const socialImageType = imageType ?? (image ? undefined : "image/png");
const locale = getLocale(Astro.currentLocale);
const route = stripLocale(
  Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "")
);
const canonicalPath = sitePath(localePath(route, locale));
const canonicalUrl = new URL(canonicalPath, Astro.site);
const alternateUrls = locales.map((alternateLocale) => ({
  locale: alternateLocale,
  url: new URL(sitePath(localePath(route, alternateLocale)), Astro.site),
}));
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {!index && <meta name="robots" content="noindex,follow" />}
    <meta name="application-name" content="AppHub" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" data-theme-color />
    <meta property="og:site_name" content="AppHub" />
    <meta property="og:locale" content={localeDefinitions[locale].openGraph} />
    {
      alternateUrls
        .filter(({ locale: alternateLocale }) => alternateLocale !== locale)
        .map(({ locale: alternateLocale }) => (
          <meta
            property="og:locale:alternate"
            content={localeDefinitions[alternateLocale].openGraph}
          />
        ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    {!image && <meta property="og:image:width" content="1280" />}
    {!image && <meta property="og:image:height" content="640" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href={logo} />
    <link rel="icon" href={sitePath("/favicon.ico")} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrls.map(({ locale: alternateLocale, url }) => (
        <link rel="alternate" hreflang={alternateLocale} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrls[0]!.url} />
    <link rel="expect" href="#main-content" blocking="render" />
    <link
      rel="alternate"
      type="application/json"
      href={sitePath("/api/v1/apps.json")}
      title={t("api.catalog")}
    />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    {description && <meta name="twitter:description" content={description} />}
  </head>
  <body class="relative m-0 flex min-h-screen flex-col font-sans">
    <script is:inline type="speculationrules">
      {
        "prefetch": [
          {
            "source": "document",
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <script is:inline>
      try {
        const saved = localStorage.getItem("apphub-theme");
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.themeMode =
          saved === "light" || saved === "dark" || saved === "system" ? saved : "system";
        document
          .querySelector("[data-theme-color]")
          ?.setAttribute(
            "content",
            document.documentElement.dataset.theme === "dark" ? "#1e1e1e" : "#fafafa"
          );
      } catch {}
    </script>
    <a
      class="fixed top-2 left-2 z-[100] -translate-y-20 rounded-lg bg-[var(--text)] px-4 py-2 text-[var(--page)] focus:translate-y-0"
      href="#main-content">{t("nav.skip")}</a
    >
    <Header />
    <main class="relative z-10 mx-auto w-full max-w-7xl grow px-4 sm:px-6" id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
