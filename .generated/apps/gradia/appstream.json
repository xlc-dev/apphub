{
  "id": "be.alexandervanhee.gradia",
  "name": "Gradia",
  "summary": "Annotate your screenshots",
  "description": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Gradia helps you get your screenshots ready for sharing, whether quickly with friends or colleagues, or professionally with the entire world."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Key features:"
        }
      ]
    },
    {
      "type": "unordered-list",
      "items": [
        [
          {
            "type": "text",
            "value": "Ten annotation modes, including text, arrow, and censor"
          }
        ],
        [
          {
            "type": "text",
            "value": "Optional image and gradient backgrounds"
          }
        ],
        [
          {
            "type": "text",
            "value": "Image settings like shadow, padding, and auto-balance"
          }
        ],
        [
          {
            "type": "text",
            "value": "Quick upload flow to easily share images via services like Imgur"
          }
        ],
        [
          {
            "type": "text",
            "value": "Convert code snippets into clean high-resolution images"
          }
        ]
      ]
    }
  ],
  "projectLicense": "GPL-3.0-or-later",
  "developer": {
    "name": "Alexander Vanhee",
    "url": "https://github.com/AlexanderVanhee"
  },
