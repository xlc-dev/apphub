{
  "id": "app.drey.Warp",
  "name": "Warp",
  "summary": "Fast and secure file transfer",
  "description": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Warp allows you to securely send files to each other via the internet or local network by exchanging a word-based code."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "The best transfer method will be determined using the “Magic Wormhole” protocol which includes local network transfer if possible."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Features"
        }
      ]
    },
    {
      "type": "unordered-list",
      "items": [
        [
          {
            "type": "text",
            "value": "Send files between multiple devices"
          }
        ],
        [
          {
            "type": "text",
            "value": "Every file transfer is encrypted"
          }
        ],
        [
          {
            "type": "text",
            "value": "Directly transfer files on the local network if possible"
          }
        ],
        [
          {
            "type": "text",
            "value": "An internet connection is required"
          }
        ],
        [
          {
            "type": "text",
            "value": "QR Code support"
          }
        ],
        [
          {
            "type": "text",
            "value": "Compatibility with the Magic Wormhole command line client and all other compatible apps"
          }
        ]
      ]
    }
  ],
  "projectLicense": "GPL-3.0-only",
  "developer": {
    "name": "Fina Wilke"
  },
  "homepage": "https://apps.gnome.org/Warp/",
  "repository": "https://gitlab.gnome.org/World/warp/",
  "links": {
    "bugtracker": "https://gitlab.gnome.org/World/warp/issues",
    "contact": "https://matrix.to/#/#warp:gnome.org",
    "translate": "https://l10n.gnome.org/module/warp/"
  },
  "contentRating": {
    "label": "Early Childhood",
    "minimumAge": 3
  },
  "keywords": [
    "Gnome",
    "GTK",
    "Wormhole"
  ],
  "categories": [
    "Utility"
  ],
  "translations": {
    "nl": {
      "summary": "Snelle en veilige bestandsoverdracht",
      "description": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Warp laat u veilig bestanden naar elkaar sturen via het internet of het lokale netwerk, door een op woorden gebaseerde code uit te wisselen."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "De beste overdrachtsmethode wordt vastgesteld door middel van het ‘Magic Wormhole’-protocol, en bevat lokale netwerkoverdracht wanneer mogelijk."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Functies"
            }
          ]
        },
        {
          "type": "unordered-list",
          "items": [
            [
              {
                "type": "text",
                "value": "Stuur bestanden tussen meerdere apparaten"
              }
            ],
            [
              {
                "type": "text",
                "value": "Elke bestandsoverdracht is versleuteld"
              }
            ],
            [
              {
                "type": "text",
                "value": "Verstuur bestanden over het lokale netwerk wanneer mogelijk"
              }
            ],
            [
              {
                "type": "text",
                "value": "Een internetverbinding is vereist"
              }
            ],
            [
              {
                "type": "text",
                "value": "QR-codeondersteuning"
              }
            ],
            [
              {
                "type": "text",
                "value": "Compatibiliteit met de ‘Magic Wormhole’-opdrachtregelcliënt en alle andere compatibele toepassingen"
              }
            ]
          ]
        }
      ],
      "contentRating": {
        "label": "3"
      }
    }
  }
}
