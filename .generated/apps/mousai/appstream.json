{
  "id": "io.github.seadve.Mousai",
  "name": "Mousai",
  "summary": "Identify songs in seconds",
  "description": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Discover songs you are aching to know with an easy-to-use interface."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Mousai is a simple application that can recognize songs similar to Shazam. Just click the listen button, and then wait a few seconds. It will magically return the title and artist of that song!"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Note: This uses the API of audd.io, so it is necessary to log in to their site to get more trials."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Why you will love Mousai?"
        }
      ]
    },
    {
      "type": "unordered-list",
      "items": [
        [
          {
            "type": "text",
            "value": "🎵 Identify songs within seconds or save for later when offline"
          }
        ],
        [
          {
            "type": "text",
            "value": "🎙️ Recognize from desktop audio or your microphone"
          }
        ],
        [
          {
            "type": "text",
            "value": "🎸 Build a repertoire of recognized songs"
          }
        ],
        [
          {
            "type": "text",
            "value": "🎼 Quickly preview the song within the interface"
          }
        ],
        [
          {
            "type": "text",
            "value": "🌐 Browse and listen the song from different providers"
          }
        ],
