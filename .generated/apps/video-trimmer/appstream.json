{
  "id": "org.gnome.gitlab.YaLTeR.VideoTrimmer",
  "name": "Video Trimmer",
  "summary": "Trim videos quickly",
  "description": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Video Trimmer cuts out a fragment of a video given the start and end timestamps. The video is never re-encoded, so the process is very fast and does not reduce the video quality."
        }
      ]
    }
  ],
