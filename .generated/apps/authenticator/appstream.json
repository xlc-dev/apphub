{
  "id": "com.belmoussaoui.Authenticator",
  "name": "Authenticator",
  "summary": "Generate two-factor codes",
  "description": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Simple application for generating Two-Factor Authentication Codes."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "Features:"
        }
      ]
    },
    {
      "type": "unordered-list",
      "items": [
        [
          {
            "type": "text",
            "value": "Time-based/Counter-based/Steam methods support"
          }
        ],
        [
          {
            "type": "text",
            "value": "SHA-1/SHA-256/SHA-512 algorithms support"
          }
        ],
        [
          {
            "type": "text",
            "value": "QR code scanner using a camera or from a screenshot"
          }
        ],
        [
          {
            "type": "text",
            "value": "Lock the application with a password"
          }
        ],
        [
          {
            "type": "text",
            "value": "Beautiful UI"
          }
        ],
        [
          {
            "type": "text",
            "value": "GNOME Shell search provider"
          }
        ],
        [
          {
            "type": "text",
            "value": "Backup/Restore from/into known applications like FreeOTP+, Aegis (encrypted / plain-text), andOTP, Google Authenticator"
          }
        ]
      ]
    }
  ],
  "projectLicense": "GPL-3.0-or-later",
  "developer": {
    "name": "Bilal Elmoussaoui"
  },
